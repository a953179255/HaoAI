<?xml version="1.0" encoding="utf-8"?>
<paths>
    <external-files-path
        name="pictures"
        path="Pictures/" />
    <!-- 仅相机临时文件目录：不再暴露整个 filesDir（settings/sessions 等不可经 FileProvider 外发） -->
    <files-path
        name="camera_shot"
        path="camera/" />
    <!-- 图片全屏查看器"分享"写出的临时文件（cache/shared） -->
    <cache-path
        name="shared"
        path="shared/" />
</paths>

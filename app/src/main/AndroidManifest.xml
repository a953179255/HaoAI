<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 电池优化白名单：REQUEST_IGNORE 对话框入口（权限中心「电池优化白名单」项） -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 任务悬浮窗：Agent 后台运行时实时显示当前步骤（仅后台显示，前台自动隐藏） -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 精确闹钟（梦境整理触发更准时）：targetSdk 33+ 默认拒绝，可在系统设置授予；
         未授予时 DreamTriggerMonitor 自动降级 ±5 分钟窗口闹钟 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- 签名级权限，普通安装拿不到；仅供用户 adb pm grant 一次性授予后实现无障碍静默自启（A11yGate） -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- Android 11+ 包可见性：声明后 getInstalledApplications/getLaunchIntentForPackage 才能看到其他应用（list_apps/launch_app） -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".HaoApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.HaoAI">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|colorMode"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- debug deep link：adb shell am start -a android.intent.action.VIEW -d "haoai://debug/<target>"
                 仅保留 DEFAULT（adb 可用）；去掉 BROWSABLE，浏览器/任意网页不可拉起。
                 consumeDeepLink 另有 FLAG_DEBUGGABLE 门禁，release 构建整段忽略。 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="haoai" android:host="debug" />
            </intent-filter>
            <!-- 系统分享接入（R2.2）：其他 app 分享文本/图片到 HaoAI -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>
        <!-- 仅应用内「设置 → 玻璃实验室」进入；adb 可用 run-as/root 启动，无需 exported -->
        <activity
            android:name=".glasslab.GlassLabActivity"
            android:exported="false"
            android:label="玻璃实验室" />

        <!-- 2.4 notifications_read：通知使用权服务（用户在系统设置中授权） -->
        <receiver
            android:name=".platform.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Phase 6 工作流外部触发（Tasker/MacroDroid/adb 广播）：须携带每流程的触发令牌 -->
        <receiver
            android:name=".platform.WorkflowTriggerReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.haoai.agent.WORKFLOW_RUN" />
            </intent-filter>
        </receiver>

        <service
            android:name=".platform.NotificationCapture"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name=".platform.KeepAliveService"
            android:exported="false"
            android:foregroundServiceType="dataSync|specialUse">
            <!-- specialUse：Android 15 对 dataSync 型前台服务有 6 小时/日上限，长任务会被系统掐断 -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="agent-background-tasks" />
        </service>

        <!-- 任务悬浮窗（无前台服务，纯 overlay；权限缺失时 start() 直接跳过） -->
        <service
            android:name=".platform.AgentOverlayService"
            android:exported="false" />

        <!-- 通知「停止」按钮 → RunObserver.requestStop（路由到 AgentRunRegistry） -->
        <receiver
            android:name=".platform.RunActionReceiver"
            android:exported="false" />

        <service
            android:name=".platform.a11y.HaoAccessibilityService"
            android:exported="true"
            android:label="@string/a11y_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 4.3 增强：Shizuku（shell uid 通道，解锁虚拟屏启动任意 App）；授权弹窗由 API 转用户确认 -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>

</manifest>

  "sleep": 1200
 },
 {
  "eval": "({row:document.querySelector('#queueRow').classList.contains('on'),chips:document.querySelectorAll('.qchip').length,msgs:document.querySelectorAll('.view.on .msg').length})"
 },
 {
  "eval": "fetch('/api/state?sid='+encodeURIComponent(curId)).then(r=>r.json()).then(s=>'撤回后 state.queue='+(s.queue||[]).length+' 还在跑='+s.running)"
 },

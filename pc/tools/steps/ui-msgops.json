[
 {
  "goto": "#box"
 },
 {
  "type": {
   "sel": "#box",
   "text": "写一个 note.txt 里面放一句话"
  }
 },
 {
  "goto": ".card",
  "timeout": 25000
 },
 {
  "sleep": 2500
 },
 {
  "eval": "(()=>{const btns=[...document.querySelectorAll('.view.on .acts2 .ab')].map(x=>x.textContent);return {hasQuote:btns.some(t=>t=='引用'),hasDel:btns.some(t=>t=='删这一句'),hasCard:document.querySelectorAll('.view.on .card').length>=1}})()",
  "must": ["hasQuote", "hasDel", "hasCard"],
  "note": "跑完之后：工具卡在、消息操作条上有后面两步真要用的那两颗钮（引用 / 删这一句）——按钮没了，下面的步骤会变成「点不到」的空转"
 },
 {
  "eval": "(()=>{const m=document.querySelector('.view.on .msg.user');m.querySelector?0:0;[...m.parentElement.querySelectorAll('*')];const bar=m.nextElementSibling;const b=[...bar.querySelectorAll('.ab')].find(x=>x.textContent=='引用');b.click();return 'clicked'})()"
 },
 {
  "sleep": 600
 },
 {
  "eval": "(()=>{const b=document.querySelector('#box');return {quoted:b.value.startsWith('> '),head:b.value.indexOf('写一个')>=0,caretAtEnd:b.selectionStart===b.value.length}})()",
  "must": ["quoted", "head", "caretAtEnd"],
  "note": "引用之后：输入框开头是 markdown 引用行且带的是那句原文，光标落在引用末尾（不然人接着打的字会插到引用前面）"
 },
 {
  "shot": "m01-quote"
 },
 {
  "eval": "(()=>{document.querySelector('#box').value='';document.querySelector('#box').dispatchEvent(new Event('input',{bubbles:true}));return 'cleared'})()"
 },
 {
  "eval": "(()=>{const r=document.querySelector('#sessions .it');const more=r&&r.querySelector('[data-a=menu]');if(!more)return {hasMore:false,why:'行上没有 ⋯ 钮'};more.click();const on=document.querySelector('.smenu.on');if(!on)return {hasMore:true,menuOpen:false};const b=on.getBoundingClientRect();const pin=on.querySelector('[data-m=pin]');return {hasMore:true,menuOpen:true,items:[...on.querySelectorAll('.mi')].map(x=>x.dataset.m).join(','),pinLabel:pin?pin.textContent.trim():'',inView:b.left>=0&&b.top>=0&&b.right<=innerWidth+1&&b.bottom<=innerHeight+1}})()",
  "must": ["hasMore", "menuOpen", "pinLabel", "inView"],
  "note": "2026-10-03 起（3ea9efe）会话卡上的置顶/重命名/删除收进了 ⋯ 菜单：上一版剧本直接点 [data-a=pin]，那颗钮早就不在行里了，于是报的是 null.click 而不是「功能坏了」。改按真流程走，并把菜单本身判清楚：⋯ 在不在、菜单开没开、置顶那条的文字、有没有跑出视口（贴底的行要翻到上方）"
 },
 {
  "shot": "m05-sess-menu"
 },
 {
  "eval": "(()=>{const mi=document.querySelector('.smenu.on [data-m=pin]');if(!mi)return {clicked:false};mi.click();return {clicked:true,closed:!document.querySelector('.smenu.on')}})()",
  "must": ["clicked"],
  "note": "点菜单里的「置顶」：动作走 /api/pin，点完菜单要自己收起（收起只打印，别当判据——它不是这批要守的东西）"
 },
 {
  "sleep": 1200
 },
 {
  "eval": "(()=>{const first=document.querySelector('#sessions .it');return {tagged:!!document.querySelector('#sessions .ptag'),pinnedFlag:!!first&&first.dataset.pinned=='1',rows:document.querySelectorAll('#sessions .it').length>0}})()",
  "must": ["tagged", "pinnedFlag", "rows"],
  "note": "点置顶之后：列表行挂上「置顶」标签、行上的 data-pinned 翻成 1（不是只在界面上画了一下）"
 },
 {
  "eval": "fetch('/api/sessions').then(r=>r.json()).then(l=>({pinned:!!(l[0]&&l[0].pinned),has:l.length>0}))",
  "must": ["pinned", "has"],
  "note": "服务端也认：置顶落了盘（界面改了、盘上没改=刷新就没了）"
 },
 {
  "shot": "m02-pinned"
 },
 {
  "eval": "(()=>{const r=document.querySelector('#sessions .it');const more=r.querySelector('[data-a=menu]');more.click();const on=document.querySelector('.smenu.on');const pin=on&&on.querySelector('[data-m=pin]');const t=pin?pin.textContent.trim():'';if(pin)pin.click();return {reopened:!!on,label:t,unpinClicked:t.indexOf('取消')>=0}})()",
  "must": ["reopened", "unpinClicked"],
  "note": "取消置顶走同一条路，但判据钉的是菜单上那行字：已经置顶的行要写「取消置顶」——菜单没读行状态的话，这里会拿到「置顶」，然后就会发生「再点一次又置顶一遍、界面看起来没反应」"
 },
 {
  "sleep": 1200
 },
 {
  "eval": "fetch('/api/sessions').then(r=>r.json()).then(l=>({none:l.every(s=>!s.pinned),tagGone:!document.querySelector('#sessions .ptag')}))",
  "must": ["none", "tagGone"],
  "note": "再点一次真的取消：服务端没有任何置顶、界面上标签也收回（只收界面不收盘=刷新又冒出来）"
 },
 {
  "shot": "m04-after-unpin"
 },
 {
  "eval": "(()=>{const t=(window.__state=null,fetch('/api/state?sid='+encodeURIComponent(curId)).then(r=>r.json()).then(s=>{window.__s=s;const i=s.messages.findIndex(m=>m.role=='tool');return 'tool index '+i}));return 'probing'})()"
 },
 {
  "sleep": 700
 },
 {
  "eval": "(()=>{const i=window.__s.messages.findIndex(m=>m.role=='tool');return fetch('/api/delmsg',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({sid:curId,index:String(i)})}).then(r=>r.json()).then(d=>({found:i>=0,refused:d.ok===false&&String(d.error||'').indexOf('工具回复')>=0}))})()",
  "must": ["found", "refused"],
  "note": "单独删工具回复要被拒（Engine.deleteAt：工具回复不能单独删，得删它上面那条调用）——悄悄删掉会让历史里留下没有调用方的孤儿结果"
 },
 {
  "eval": "(()=>{window.confirm=()=>true;const ms=[...document.querySelectorAll('.view.on .msg.user')],m=ms[ms.length-1],b=[...m.nextElementSibling.querySelectorAll('.ab')].find(x=>x.textContent=='删这一句');b.click();return 'deleting'})()"
 },
 {
  "sleep": 2200
 },
 {
  "eval": "(()=>{const toast=document.querySelector('#toast').textContent;return {toast:toast.length>0,gone:document.querySelectorAll('.view.on .msg.user').length===0,msgs:document.querySelectorAll('.view.on .msg').length,cards:document.querySelectorAll('.view.on .card').length}})()",
  "must": ["gone"],
  "note": "删这一句真的没了（用户消息一条不剩）；toast 与剩余条数只打印给人看"
 },
 {
  "shot": "m03-deleted"
 }
]
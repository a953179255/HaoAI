[
  {
    "goto": "#box"
  },
  {
    "click": "#cfgBtn"
  },
  {
    "sleep": 900
  },
  {
    "eval": "(()=>{const dg=document.querySelector('#dialog');const k=dg.querySelector('#bKeys');return {section:!!dg.querySelector('#bList'),keyDefaultOn:k.checked,keyHint:(k.closest('.sw')||{textContent:''}).textContent.replace(/\\s+/g,' ').trim().slice(0,60),exportBtn:dg.querySelector('#bExport').textContent,state:dg.querySelector('#bState').textContent,note:dg.querySelector('#bList').textContent.trim().slice(0,40)}})()"
  },
  {
    "shot": "b01-section"
  },
  {
    "click": "#bExport"
  },
  {
    "sleep": 1800
  },
  {
    "eval": "(()=>{const dg=document.querySelector('#dialog');const rows=[...dg.querySelectorAll('#bList .rl')];return {state:dg.querySelector('#bState').textContent,rows:rows.length,first:rows[0]?rows[0].textContent.replace(/\\s+/g,' ').trim().slice(0,70):null,hasRestore:!!(rows[0]&&rows[0].querySelector('[data-bres]')),hasDelete:!!(rows[0]&&rows[0].querySelector('[data-bdel]'))}})()"
  },
  {
    "shot": "b02-exported"
  },
  {
    "click": "#bList [data-bres]"
  },
  {
    "sleep": 400
  },
  {
    "eval": "(()=>{const b=document.querySelector('#bList [data-bres]');const r=b.getBoundingClientRect();const row=b.closest('.rl').getBoundingClientRect();return {armed:b.textContent,w:Math.round(r.width),fits:r.right<=row.right+1&&r.left>=row.left,stillRows:document.querySelectorAll('#bList .rl').length,mask:document.querySelector('#mask').classList.contains('on')}})()"
  },
  {
    "shot": "b03-armed"
  },
  {
    "eval": "(()=>{const b=document.querySelector('#bList [data-bres]');const r=b.getBoundingClientRect();const row=b.closest('.rl');return {text:b.textContent,btnW:Math.round(r.width),btnLeft:Math.round(r.left),rowW:Math.round(row.getBoundingClientRect().width),btns:[...row.querySelectorAll('.ab')].map(x=>x.textContent)}})()"
  },
  {
    "click": "#bList [data-bres]"
  },
  {
    "sleep": 3000
  },
  {
    "eval": "({reloaded:document.querySelector('#dialog h3')===null,mask:document.querySelector('#mask').classList.contains('on'),toast:document.querySelector('#toast').textContent})"
  },
  {
    "eval": "fetch('/api/backups').then(r=>r.json()).then(j=>({count:j.items.length,names:j.items.map(i=>i.name),hasPre:j.items.some(i=>i.name.indexOf('pre-restore-')===0)}))"
  },
  {
    "shot": "b04-after-restore"
  }
]

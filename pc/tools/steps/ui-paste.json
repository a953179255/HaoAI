[
  {"goto": "#box"},
  {"eval": "(()=>{const dt=new DataTransfer();dt.items.add(new File(['seed'],'dragged.txt',{type:'text/plain'}));document.dispatchEvent(new DragEvent('dragenter',{dataTransfer:dt,bubbles:true}));return 'entered'})()"},
  {"eval": "(()=>{const m=document.querySelector('#dropMask');const s=getComputedStyle(m);return {mask:m.classList.contains('on'),shown:s.display==='flex',hint:m.querySelector('.dz').textContent.replace(/\\s+/g,' ').trim().indexOf('松开')===0,pe:s.pointerEvents==='none'}})()",
   "must": ["mask", "shown", "hint", "pe"], "note": "拖进来那一刻：遮罩挂上、真的显示出来（display 从 none 变 flex 才算「显示」）、提示语是那句「松开」、并且不吃鼠标（pointer-events:none，否则松手那下点在遮罩上）"},
  {"shot": "p01-drag-hint"},
  {"eval": "(()=>{const dt=new DataTransfer();dt.items.add(new File(['seed'],'dragged.txt',{type:'text/plain'}));document.dispatchEvent(new DragEvent('drop',{dataTransfer:dt,bubbles:true,cancelable:true}));return 'dropped'})()"},
  {"sleep": 1500},
  {"eval": "(()=>{const m=document.querySelector('#dropMask');const box=document.querySelector('#box').value.replace(/\\s+/g,' ').trim();return {gone:!m.classList.contains('on'),head:box.indexOf('【附件 dragged.txt】')===0,seedy:box.indexOf('seed')>=0}})()",
   "must": ["gone", "head", "seedy"], "note": "松手之后：遮罩撤掉、输入框里出现附件占位与文件内容（粘完什么都没有=这条链路白做）"},
  {"shot": "p02-after-drop"},
  {"eval": "(()=>{const c=document.createElement('canvas');c.width=c.height=40;const g=c.getContext('2d');g.fillStyle='#e0a53b';g.fillRect(0,0,40,40);return new Promise(res=>c.toBlob(b=>{const dt=new DataTransfer();dt.items.add(new File([b],'image.png',{type:'image/png'}));const ev=new ClipboardEvent('paste',{clipboardData:dt,bubbles:true,cancelable:true});document.querySelector('#box').dispatchEvent(ev);res({taken:ev.defaultPrevented&&b.size>0})},'image.png'))})()",
   "must": ["taken"], "note": "图片粘贴被输入框接下（preventDefault=交给我们的处理器），且拿到的是真字节不是空 blob"},
  {"sleep": 1500},
  {"eval": "(()=>{const chips=[...document.querySelectorAll('.atchip')];const prev=[...document.querySelectorAll('.atchip .ath')];return {one:chips.length===1,named:chips[0]?chips[0].textContent.indexOf('image.png')>=0:false,thumb:prev.length===1&&prev[0].naturalWidth===40,row:document.querySelector('#attRow').classList.contains('on'),toast:document.querySelector('#toast').textContent.indexOf('已附上')>=0}})()",
   "must": ["one", "named", "thumb", "row", "toast"], "note": "一颗 chip：有名字、缩略图真的解码出 40 宽（假字节画不出 naturalWidth）、附件行展开、toast 报了「已附上」"},
  {"shot": "p03-pasted-image"},
  {"eval": "(()=>{const c=document.createElement('canvas');c.width=c.height=28;const g=c.getContext('2d');g.fillStyle='#3ba55d';g.fillRect(0,0,28,28);return new Promise(res=>c.toBlob(b=>{const dt=new DataTransfer();dt.items.add(new File([b],'',{type:'image/png'}));document.querySelector('#box').dispatchEvent(new ClipboardEvent('paste',{clipboardData:dt,bubbles:true,cancelable:true}));res('nameless')},'image/png'))})()"},
  {"sleep": 1500},
  {"eval": "(()=>{const names=[...document.querySelectorAll('.atchip b')].map(x=>x.textContent);return {two:document.querySelectorAll('.atchip').length===2,named:names.some(t=>t.indexOf('粘贴图片')>=0)}})()",
   "must": ["two", "named"], "note": "没文件名的截图要有默认名（否则 chip 上一片空白，人不知道贴了什么）"},
  {"shot": "p04-nameless-image"},
  {"eval": "(()=>{const dt=new DataTransfer();dt.setData('text/plain','一段要贴进输入框的字');const ev=new ClipboardEvent('paste',{clipboardData:dt,bubbles:true,cancelable:true});document.querySelector('#box').dispatchEvent(ev);return({notPrevented:!ev.defaultPrevented,noChip:document.querySelectorAll('.atchip').length===2})})()",
   "must": ["notPrevented", "noChip"], "note": "文本粘贴不归附件管：不 preventDefault（浏览器自己插字），也不许多出一颗 chip"},
  {"sleep": 600},
  {"eval": "({stillTwo:document.querySelectorAll('.atchip').length===2,note:'合成 paste 不会让浏览器真插入文本，判据是 prevented=false'})",
   "must": ["stillTwo"], "note": "睡一会之后附件也没被顺手清掉"},
  {"type": {"sel": "#box", "text": "看着这张截图说一句"}},
  {"goto": ".msg.ans", "timeout": 25000},
  {"sleep": 3000},
  {"eval": "(()=>{const list=[...document.querySelectorAll('.msg.user .thumbs img')];list.forEach(i=>i.scrollIntoView({block:'center'}));return Promise.all(list.map(i=>i.decode().catch(()=>null))).then(()=>({two:list.length===2,loaded:list.filter(i=>i.naturalWidth>0).length===2,cleared:document.querySelectorAll('.atchip').length===0}))})()",
   "must": ["two", "loaded", "cleared"], "note": "发出去之后：两张图真进了消息气泡（decode 完 naturalWidth>0 才算画得出来），附件行清空（不然下一句会重复带一遍）"},
  {"shot": "p05-sent-with-paste"}
]

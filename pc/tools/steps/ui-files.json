[
  {"goto": "#box"},
  {"type": {"sel": "#box", "text": "验收：建一个 hello.txt 并把第一行改掉"}},
  {"goto": ".cbar", "timeout": 30000},
  {"sleep": 2000},
  {"click": "#tabs button[data-t=\"files\"]"},
  {"sleep": 900},
  {"eval": "(()=>{const p=document.getElementById('filePath').innerText;const rows=[...document.querySelectorAll('#files .fe')];return {hasPath:p.length>0,rows:rows.length>=1,hello:rows.some(r=>r.innerText.indexOf('hello.txt')>=0)}})()",
   "must": ["hasPath", "rows", "hello"], "note": "文件页签：路径栏有值、列出文件、清单里找得到刚生成的 hello.txt（目录排在前面，所以看「全部行里有没有」而不是「第一行」；跑完却看不见产物=白跑）"},
  {"shot": "f01-files"},
  {"click": "#files .fe[data-p=\"hello.txt\"]"},
  {"sleep": 700},
  {"eval": "(()=>{const pv=(document.querySelector('#dialog .pv')||{}).innerText||'';return {maskOn:document.getElementById('mask').classList.contains('on'),shows:pv.indexOf('hello')>=0}})()",
   "must": ["maskOn", "shows"], "note": "点文件名弹预览：对话框开着，正文是那个文件的内容（能读回改过的那行）"},
  {"shot": "f02-preview"},
  {"click": "#dlgClose"},
  {"eval": "fetch('/api/files?sid='+curId+'&path=../../../../Windows').then(r=>r.json()).then(d=>({noEscape:(d.path||'').indexOf('..')<0&&(d.path||'').indexOf('Windows')<0&&(d.path||'').indexOf(':')<0,hasEntries:(d.entries||[]).length>=1}))",
   "must": ["noEscape", "hasEntries"], "note": "目录穿越不越界：../.. 那串被 canonical 后落回工作区根（path 里既没有 .. 也不是绝对路径），列的仍是区内条目"},
  {"eval": "fetch('/api/file?sid='+curId+'&path=../../settings.json').then(r=>({blocked:r.status>=400}))",
   "must": ["blocked"], "note": "读工作区外的文件拿 4xx（200=把 HAOAI_HOME 里的设置读给浏览器了）"},
  {"eval": "fetch('/api/file?sid='+curId+'&path=.haoai-attach/../hello.txt').then(r=>r.json()).then(d=>({ok:d.ok===true}))",
   "must": ["ok"], "note": "绕一圈但仍在区内（.haoai-attach/../ 规范化回 hello.txt）要能读到——拦的是「出去」，不是「绕」；拦成 404=canonical 判定写反了"}
]

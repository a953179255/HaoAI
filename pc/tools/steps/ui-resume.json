[
  {"goto": "#box"},
  {"sleep": 1500},
  {"eval": "fetch('/api/sessions').then(r=>r.json()).then(l=>({seeded:l.map(m=>m.id).filter(i=>i.indexOf('resume-')===0),total:l.length}))"},
  {"click": "#sessions .it[data-id=\"resume-demo\"]"},
  {"sleep": 1500},
  {"eval": "(()=>{const b=document.querySelector('.view.on .resume');if(!b)return {banner:'MISSING'};const r=b.getBoundingClientRect();const box=document.querySelector('#box').getBoundingClientRect();return {sid:curId,bannersHere:document.querySelectorAll('.view.on .resume').length,bannersAll:document.querySelectorAll('.resume').length,heading:b.querySelector('b').textContent,goal:b.querySelector('i').textContent,go:(b.querySelector('[data-rs=go]')||{}).textContent,no:(b.querySelector('[data-rs=no]')||{}).textContent,top:Math.round(r.top),h:Math.round(r.height),left:Math.round(r.left),right:Math.round(r.right),boxTop:Math.round(box.top),winW:window.innerWidth,msgs:document.querySelectorAll('.view.on .msg').length}})()"},
  {"shot": "r01-banner"},
  {"click": "#sessions .it[data-id=\"resume-drop\"]"},
  {"sleep": 1500},
  {"eval": "(()=>({sid:curId,bannersHere:document.querySelectorAll('.view.on .resume').length,bannersAll:document.querySelectorAll('.resume').length,heading:(document.querySelector('.view.on .resume b')||{}).textContent,msgs:document.querySelectorAll('.view.on .msg').length}))()"},
  {"shot": "r02-second-session"},
  {"click": ".view.on .resume [data-rs=no]"},
  {"sleep": 1200},
  {"eval": "({bannersHere:document.querySelectorAll('.view.on .resume').length,bannersAll:document.querySelectorAll('.resume').length,toast:document.querySelector('#toast').textContent})"},
  {"eval": "fetch('/api/state?sid=resume-drop').then(r=>r.json()).then(s=>({dropRunState:s.runState,dropMsgs:(s.messages||[]).length}))"},
  {"eval": "fetch('/api/state?sid=resume-demo').then(r=>r.json()).then(s=>({demoRunState:s.runState&&s.runState.turn,demoGoal:s.runState&&s.runState.goal.slice(0,18)}))"},
  {"shot": "r03-abandoned"},
  {"click": "#sessions .it[data-id=\"resume-demo\"]"},
  {"sleep": 1500},
  {"eval": "({sid:curId,bannersHere:document.querySelectorAll('.view.on .resume').length,heading:(document.querySelector('.view.on .resume b')||{}).textContent,msgs:document.querySelectorAll('.view.on .msg').length})"},
  {"eval": "(()=>{window.__before=document.querySelectorAll('.view.on .msg').length;return 'before '+window.__before})()"},
  {"click": ".view.on .resume [data-rs=go]"},
  {"sleep": 3000},
  {"eval": "({bannersHere:document.querySelectorAll('.view.on .resume').length,msgs:document.querySelectorAll('.view.on .msg').length,before:window.__before,toast:document.querySelector('#toast').textContent,lastUser:[...document.querySelectorAll('.view.on .msg.user')].pop().textContent.replace(/\\s+/g,' ').slice(0,46),answers:[...document.querySelectorAll('.view.on .msg.ans')].pop().textContent.replace(/\\s+/g,' ').slice(0,52)})"},
  {"shot": "r04-resumed"},
  {"eval": "fetch('/api/state?sid=resume-demo').then(r=>r.json()).then(s=>({runStateAfter:s.runState,running:s.running,msgs:(s.messages||[]).length,lastRole:(s.messages||[]).slice(-1).map(m=>m.role),resumeSent:(s.messages||[]).filter(m=>m.content&&m.content.indexOf('接着上次没跑完')>=0).length}))"}
]

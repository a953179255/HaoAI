[
  {"goto": "#box"},
  {"sleep": 1500},
  {"eval": "fetch('/api/sessions').then(r=>r.json()).then(l=>({seeded:l.map(m=>m.id).filter(i=>i.indexOf('resume-')===0).length>=2,total:l.length>=2}))",
   "must": ["seeded", "total"], "note": "夹具两条现场会话都进来了（没有它们下面全是空转）"},
  {"click": "#sessions .it[data-id=\"resume-demo\"]"},
  {"sleep": 1500},
  {"eval": "(()=>{const b=document.querySelector('.view.on .resume');if(!b)return {banner:false};const r=b.getBoundingClientRect();return {banner:true,one:document.querySelectorAll('.view.on .resume').length===1,heading:((b.querySelector('b')||{}).textContent||'').indexOf('上次')>=0,hasGoal:((b.querySelector('i')||{}).textContent||'').length>0,go:!!b.querySelector('[data-rs=go]'),no:!!b.querySelector('[data-rs=no]'),onScreen:r.top>=0&&r.height>0&&r.right<=window.innerWidth,msgs:document.querySelectorAll('.view.on .msg').length>=1}})()",
   "must": ["banner", "one", "heading", "hasGoal", "go", "no", "onScreen", "msgs"], "note": "续跑横幅：只有这条会话有（一条）、写着上次跑到第几轮、目标原样带着、两颗按钮在、横幅在视口内（跑到输入框底下=点不到）"},
  {"shot": "r01-banner"},
  {"click": "#sessions .it[data-id=\"resume-drop\"]"},
  {"sleep": 1500},
  {"eval": "(()=>{const b=document.querySelector('.view.on .resume');return {banner:!!b,onlyHere:document.querySelectorAll('.view.on .resume').length===1,across:document.querySelectorAll('.resume').length>=2,msgs:document.querySelectorAll('.view.on .msg').length>=1}})()",
   "must": ["banner", "onlyHere", "across", "msgs"], "note": "第二条也有自己的横幅（切过来才画），两条横幅各在各的视图里、不互相串"},
  {"shot": "r02-second-session"},
  {"click": ".view.on .resume [data-rs=no]"},
  {"sleep": 1200},
  {"eval": "(()=>{return {gone:document.querySelectorAll('.view.on .resume').length===0,otherKept:document.querySelectorAll('.resume').length>=1,toast:document.querySelector('#toast').textContent.indexOf('现场')>=0}})()",
   "must": ["gone", "otherKept", "toast"], "note": "「丢掉这段」：这条的横幅收掉、别条的还在（横幅是会话自己的）、toast 交代了丢的是现场"},
  {"eval": "fetch('/api/state?sid=resume-drop').then(r=>r.json()).then(s=>({dropRunState:!s.runState,msgsKept:(s.messages||[]).length===3}))",
   "must": ["dropRunState", "msgsKept"], "note": "丢掉的只是现场（runState 没了），已发生的消息一条不少（连历史一起删=「放弃」变成了「删会话」）"},
  {"eval": "fetch('/api/state?sid=resume-demo').then(r=>r.json()).then(s=>({hasState:!!s.runState,turn:s.runState&&s.runState.turn===3,hasGoal:!!(s.runState&&s.runState.goal)}))",
   "must": ["hasState", "turn", "hasGoal"], "note": "没动过的那条现场原封不动（轮次、目标都还在——丢一条不该伤到另一条）"},
  {"shot": "r03-abandoned"},
  {"click": "#sessions .it[data-id=\"resume-demo\"]"},
  {"sleep": 1500},
  {"eval": "(()=>{const b=document.querySelector('.view.on .resume');return {banner:!!b,heading:!!b&&((b.querySelector('b')||{}).textContent||'').indexOf('上次')>=0,msgs:document.querySelectorAll('.view.on .msg').length>=1}})()",
   "must": ["banner", "heading", "msgs"], "note": "切回来横幅还在（横幅不是一次性的）"},
  {"eval": "(()=>{window.__before=document.querySelectorAll('.view.on .msg').length;return 'before '+window.__before})()"},
  {"click": ".view.on .resume [data-rs=go]"},
  {"sleep": 3000},
  {"eval": "(()=>{const lastUser=[...document.querySelectorAll('.view.on .msg.user')].pop();const lastAns=[...document.querySelectorAll('.view.on .msg.ans')].pop();return {bannerGone:document.querySelectorAll('.view.on .resume').length===0,grew:document.querySelectorAll('.view.on .msg').length>window.__before,hasUser:!!lastUser,hasAns:!!lastAns&&lastAns.textContent.length>0}})()",
   "must": ["bannerGone", "grew", "hasUser", "hasAns"],
   "note": "点了「从中断续跑」：横幅收掉（现场已被接管）、消息变多（续跑真的发出去了）、这一问一答都在"},
  {"shot": "r04-resumed"},
  {"eval": "fetch('/api/state?sid=resume-demo').then(r=>r.json()).then(s=>({resumeSent:(s.messages||[]).filter(m=>m.content&&m.content.indexOf('接着上次没跑完')>=0).length>=1,answered:(s.messages||[]).slice(-1)[0].role==='assistant',msgs:(s.messages||[]).length>=8}))",
   "must": ["resumeSent", "answered", "msgs"],
   "note": "状态侧钉死：续跑那句话（Engine.resumePrompt 的原文）真进了历史、模型答完了（最后一 role 是 assistant——mock 两三秒就答完，量 running 在这个时间点上恒 false）、消息数比夹具多"}
]

  "eval": "(()=>{const all=(document.querySelector('#usageAll')||{}).textContent||'';const rows=[...document.querySelectorAll('#usageModels .mrow')];const bar=rows[0]?rows[0].querySelector('i'):null;return {hasAll:all.length>0,one:rows.length>=1,bar:!!bar&&(bar.style.width||'').length>0}})()",
  "must": ["hasAll", "one", "bar"],
  "note": "用量总账有数、按模型至少一行、那一行的占比条有宽度（宽度是算出来填进 style 的，空=排版没跑）"
 },
 {
  "eval": "(()=>{const bars=[...document.querySelectorAll('#usageDays .bar')];const fills=bars.map(x=>x.querySelector('span')).filter(Boolean);const heights=fills.map(x=>Math.round(x.getBoundingClientRect().height)).filter(h=>h>0);const labels=[...document.querySelectorAll('#usageDays .bar em')].slice(-2).map(x=>x.textContent);const meta=(document.querySelector('#usageMeta')||{}).textContent||'';return {bars:bars.length>=1,grown:heights.length>=1,labels:labels.length>=1,hasMeta:meta.length>0}})()",
  "must": ["bars", "grown", "labels", "hasMeta"],
  "note": "按天的柱状图：有柱子、今天这根真的有高度（0 高=数据没接上）、带日期标签、下面那行汇总在（原剧本这里把 textContent 打成了 textConten，恒空）"

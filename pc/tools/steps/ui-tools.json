[
 {
  "goto": "#box"
 },
 {
  "click": "#tabs button[data-t=\"tools\"]"
 },
 {
  "sleep": 1200
 },
 {
  "eval": "(()=>{const c=document.querySelector('[data-tn=shell]');return {rows:document.querySelectorAll('#toolRows .trow').length>=10,shellOn:!!c&&c.checked===true,notOff:!!c&&!c.closest('.trow').classList.contains('off'),hasSum:((document.querySelector('#toolsSum')||{}).textContent||'').length>0}})()",
  "must": ["rows", "shellOn", "notOff", "hasSum"],
  "note": "工具页签一开：行数是全套工具、shell 默认开着（行上没有 off）、汇总句在（下面几步要看着它变）"
 },
 {
  "click": "[data-tn=shell]"
 },
 {
  "sleep": 1500
 },
 {
  "eval": "(()=>{const c=document.querySelector('[data-tn=shell]');return {off:!c.checked,rowOff:c.closest('.trow').classList.contains('off'),toast:((document.querySelector('#toast')||{}).textContent||'').length>0}})()",
  "must": ["off", "rowOff", "toast"],
  "note": "点一下关掉：勾选没了、行挂上 off 样式、toast 报了这一下（无声无息=用户不知道自己刚关了 shell）"
 },
 {
   "eval": "fetch('/api/state?sid='+encodeURIComponent(curId)).then(r=>r.json()).then(s=>({offSaved:(s.tools||[]).some(t=>t.name==='shell'&&t.off)}))",
   "must": ["offSaved"],
   "note": "落盘侧也认（状态里 shell 那把标着 off）——只改界面不改状态=刷新回来又开着。state 顶层没有 toolsOff 这个字段，开关在 tools 数组里"
 },
 {
  "shot": "v01-shell-off"
 },
 {
  "type": {
   "sel": "#box",
   "text": "说一句让这条非空"
  }
 },
 {
  "goto": ".msg.ans",
  "timeout": 25000
 },
 {
  "sleep": 2500
 },
 {
  "click": "#tabs button[data-t=\"tools\"]"
 },
 {
  "sleep": 800
 },
 {
   "eval": "(()=>{const c=document.querySelector('[data-tn=shell]');return{stillOff:!!c&&!c.checked}})()",
   "must": ["stillOff"],
   "note": "中间跑了一轮之后开关没被 hydrate 冲回默认"
 },
 {
   "eval": "(()=>{window.__a=curId;return 'sid '+curId.slice(0,7)+' sessions '+document.querySelectorAll('#sessions .it').length})()"
  },
  {
   "click": "#newBtn"
  },
  {
   "sleep": 1500
  },
  {
   "eval": "(()=>{const b=curId!==window.__a;return fetch('/api/state?sid='+encodeURIComponent(curId)).then(r=>r.json()).then(s=>({switched:b,shellBackOn:(document.querySelector('[data-tn=shell]')||{}).checked===true,notOff:(s.tools||[]).some(t=>t.name==='shell'&&!t.off)}))})()",
   "must": ["switched", "shellBackOn", "notOff"],
   "note": "新开一条：会话真的切过去了（id 与点之前不同——先记再点，点完才记就永远等不出变化）、工具开关是会话级的：新会话里 shell 回到开着（状态与面板两边都要对）。原剧本把记录放在点之后，switched 恒 false 却没人看得见"
 },
 {
  "click": "#newBtn"
 },
 {
  "sleep": 1500
 },
 {
   "eval": "(()=>{const c=document.querySelector('[data-tn=shell]');return{rows:document.querySelectorAll('#toolRows .trow').length>=10,shellOn:!!c&&c.checked===true}})()",
   "must": ["rows", "shellOn"],
   "note": "再开一条也一样：面板有全套行、shell 开着（截图 v02 要的正是「另一条会话是开的」）"
 },
 {
  "shot": "v02-other-session-on"
 },
 {
  "url": "about:blank"
 },
 {
  "sleep": 300
 }
]
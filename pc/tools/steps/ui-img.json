  "eval": "setTimeout(()=>location.reload(),60)"
 },
 {
  "eval": "(async()=>{const im=[...document.querySelectorAll('.thumbs img')];const out=[];for(const i of im){const r=await fetch(i.src);out.push({st:r.status,ct:r.headers.get('content-type'),len:(await r.blob()).size})}return {n:im.length>=2,ok:out.length>=2&&out.every(x=>x.st===200&&x.ct==='image/png'&&x.len>0)}})()",
  "must": ["n", "ok"],
  "note": "刷新前先探一遍：每张缩略图都拉得动（200 + image/png + 真字节——404 或当文本发=换个页面就花）"
 },

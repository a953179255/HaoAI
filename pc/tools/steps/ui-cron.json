[
  {"goto": "#box"},
  {"type": {"sel": "#crName", "text": "早间巡检"}},
  {"type": {"sel": "#crPrompt", "text": "看一下今天的构建日志，有报错就写清是哪一条"}},
  {"eval": "$('#crEvery').value='30'"},
  {"click": "#tabs button[data-t=\"cron\"]"},
  {"sleep": 400},
  {"eval": "(()=>{const tab=document.querySelector('#tab-cron');return {tab:tab&&tab.offsetParent!==null,list:!!document.querySelector('#cronList'),every:$('#crEvery').value==='30',kind:($('#crKind').value||'').length>0,ver:($('#ver').textContent||'').length>0}})()",
   "must": ["tab", "list", "every", "kind", "ver"], "note": "自动化页签打得开：列表在、隔多久那格是刚设的 30、类型下拉有值、版本号在"},
  {"click": "#crAdd"},
  {"sleep": 600},
  {"eval": "(()=>{const btns=[...document.querySelectorAll('#cronList [data-cr]')].map(b=>b.dataset.cr);return {one:document.querySelectorAll('#cronList .rl.cron').length===1,named:(document.querySelector('#cronList b')||{}).textContent==='早间巡检',hasRun:btns.includes('run'),hasToggle:btns.includes('toggle'),hasDel:btns.includes('del'),inputsLeft:$('#crPrompt').value.length===0}})()",
   "must": ["one", "named", "hasRun", "hasToggle", "hasDel", "inputsLeft"], "note": "加进列表：一条、名字对、三颗操作钮都在、输入框清空（不清=下一条会把上一条的话带进去）"},
  {"shot": "c01-cron-list"},

  {"type": {"sel": "#crName", "text": "周报草稿"}},
  {"type": {"sel": "#crPrompt", "text": "把这周改了什么写成一份周报草稿"}},
  {"eval": "$('#crKind').value='daily';$('#crAt').value='18:30';Cron.sync()"},
  {"eval": "(()=>({everyHidden:$('#crEvery').offsetParent===null,atShown:$('#crAt').offsetParent!==null}))()",
   "must": ["everyHidden", "atShown"], "note": "切成「每天几点」：隔多久那格让位、几点那格现身（两格都开着=人不知道该填哪个）"},
  {"click": "#crAdd"},
  {"sleep": 600},
  {"eval": "(()=>{const whens=[...document.querySelectorAll('#cronList em')].map(e=>e.textContent);return {two:document.querySelectorAll('#cronList .rl.cron').length===2,hasDaily:whens.some(t=>t.indexOf('18:30')>=0||t.indexOf('18：30')>=0)}})()",
   "must": ["two", "hasDaily"], "note": "第二条进列表，且写的是 18:30 那个时刻（时刻没落上=每天跑的排成了别的）"},
  {"eval": "(()=>{const l=document.querySelector('#cronList'),r=l.getBoundingClientRect();const cards=[...l.querySelectorAll('.rl.cron')].map(c=>Math.round(c.getBoundingClientRect().bottom));const cut=cards.filter(b=>b>Math.round(r.bottom)+1).length;const rail=document.querySelector('.rail.r');return {twoCards:cards.length===2,reachable:cut===0||l.scrollHeight>l.clientHeight,railScrolls:rail.scrollHeight>rail.clientHeight}})()",
   "must": ["twoCards", "reachable"],
   "note": "两张卡都渲染了；被列表边界裁掉的那张必须还能滚出来（#tab-cron 特意放开内滚，就是防「第二张卡被齐腰切断」）；railScrolls 只打印"},
  {"shot": "c02-cron-two"},

  {"click": "#cronList [data-cr=\"run\"]"},
  {"sleep": 1200},
  {"eval": "(()=>{const sess=[...document.querySelectorAll('.sess .it')].map(i=>i.textContent);return {ran:sess.some(t=>t.indexOf('早间巡检')>=0)}})()",
   "must": ["ran"], "note": "「跑一次」立刻起了会话，标题就是任务名（跑没跑=左栏多没多那条）"},
  {"shot": "c03-cron-ran"},

  {"click": "#cronList [data-cr=\"toggle\"]"},
  {"sleep": 500},
  {"eval": "(()=>{const off=document.querySelectorAll('#cronList .off').length;return {paused:off===1}})()",
   "must": ["paused"], "note": "暂停真的标到第一条上（.off 挂上了才有灰掉的样式）"},
  {"shot": "c04-cron-paused"},
  {"click": "#cronList [data-cr=\"toggle\"]"},
  {"sleep": 500},
  {"click": "#cronList .rl.cron:nth-child(2) [data-cr=\"del\"]"},
  {"sleep": 500},
  {"eval": "(()=>{const names=[...document.querySelectorAll('#cronList b')].map(b=>b.textContent);return {one:document.querySelectorAll('#cronList .rl.cron').length===1,kept:names[0]==='早间巡检'}})()",
   "must": ["one", "kept"], "note": "删的是第二条，第一条还在（删错行=排期悄悄少一条）"},

  {"click": "#cfgBtn"},
  {"sleep": 700},
  {"eval": "(()=>{const eff=document.querySelector('#fEff'),ctx=document.querySelector('#fCtx'),max=document.querySelector('#fMax'),key=document.querySelector('#fKey');return {eff:!!eff,effOpts:eff?eff.options.length>=2:false,ctx:!!ctx&&(ctx.value||'').length>0,max:!!max&&+max.value>0,keyType:key?key.type==='password':false}})()",
   "must": ["eff", "effOpts", "ctx", "max", "keyType"],
   "note": "设置抽屉：推理力度下拉有得选、上下文与 maxTokens 都有值、API key 是密码框"},
  {"shot": "c05-cfg-effort"},
  {"eval": "(()=>{const s=document.querySelector('#fEff');s.value='high';s.dispatchEvent(new Event('change'));return '已选 '+s.value})()"},
  {"click": "#cfgSave"},
  {"sleep": 700},
  {"eval": "fetch('/api/settings').then(r=>r.json()).then(c=>({saved:c.reasoningEffort==='high'}))",
   "must": ["saved"],
   "note": "服务端真记下了 high（界面上选了、盘上没存=重启回到默认）"},
  {"click": "#cfgBtn"},
  {"sleep": 700},
  {"eval": "(()=>{const s=document.querySelector('#fEff');return {back:!!s&&s.value==='high',label:!!s&&s.selectedOptions[0].textContent.length>0}})()",
   "must": ["back", "label"],
   "note": "重新打开：下拉还停在 high 且回填了文字（存了但回显不出=人不知道现在是什么档）"},
  {"eval": "(()=>{const s=document.querySelector('#fEff');s.value='';return '清回默认'})()"},
  {"click": "#cfgSave"},
  {"sleep": 500},
  {"eval": "fetch('/api/settings').then(r=>r.json()).then(c=>({cleared:!(c.reasoningEffort||'').length}))",
   "must": ["cleared"],
   "note": "清空再存：回去是空（空=不给请求发这个字段，回到网关默认）"}
]

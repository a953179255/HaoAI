[
  {"goto": "#box"},
  {"type": {"sel": "#crName", "text": "早间巡检"}},
  {"type": {"sel": "#crPrompt", "text": "看一下今天的构建日志，有报错就写清是哪一条"}},
  {"eval": "$('#crEvery').value='30'"},
  {"click": "#tabs button[data-t=\"cron\"]"},
  {"sleep": 400},
  {"eval": "({tab:document.querySelector('#tab-cron').offsetParent!==null,list:(document.querySelector('#cronList')||{}).textContent.slice(0,20),every:$('#crEvery').value,kind:$('#crKind').value,ver:$('#ver').textContent})"},
  {"click": "#crAdd"},
  {"sleep": 600},
  {"eval": "({rows:document.querySelectorAll('#cronList .rl.cron').length,name:(document.querySelector('#cronList b')||{}).textContent,when:(document.querySelectorAll('#cronList em')[0]||{}).textContent,last:(document.querySelectorAll('#cronList em')[1]||{}).textContent,off:document.querySelectorAll('#cronList .off').length,btns:[...document.querySelectorAll('#cronList [data-cr]')].map(b=>b.dataset.cr).join(','),inputsLeft:$('#crPrompt').value.length})"},
  {"shot": "c01-cron-list"},

  {"type": {"sel": "#crName", "text": "周报草稿"}},
  {"type": {"sel": "#crPrompt", "text": "把这周改了什么写成一份周报草稿"}},
  {"eval": "$('#crKind').value='daily';$('#crAt').value='18:30';syncCronKind()"},
  {"eval": "({everyShown:$('#crEvery').offsetParent!==null,atShown:$('#crAt').offsetParent!==null})"},
  {"click": "#crAdd"},
  {"sleep": 600},
  {"eval": "({rows:document.querySelectorAll('#cronList .rl.cron').length,when:[...document.querySelectorAll('#cronList em')].map(e=>e.textContent)})"},
  {"eval": "(()=>{const l=document.querySelector('#cronList'),r=l.getBoundingClientRect();const cards=[...l.querySelectorAll('.rl.cron')].map(c=>Math.round(c.getBoundingClientRect().bottom));return {listH:Math.round(r.height),scrollH:l.scrollHeight,cutBelow:cards.filter(b=>b>Math.round(r.bottom)+1).length,panelScroll:document.querySelector('.rail.r').scrollHeight>document.querySelector('.rail.r').clientHeight}})()"},
  {"shot": "c02-cron-two"},

  {"click": "#cronList [data-cr=\"run\"]"},
  {"sleep": 1200},
  {"eval": "({sessions:[...document.querySelectorAll('.sess .it')].map(i=>i.textContent.trim().slice(0,26)),cron:[...document.querySelectorAll('#cronList em')].map(e=>e.textContent),cur:document.querySelector('#title').textContent})"},
  {"shot": "c03-cron-ran"},

  {"click": "#cronList [data-cr=\"toggle\"]"},
  {"sleep": 500},
  {"eval": "({off:document.querySelectorAll('#cronList .off').length,when:[...document.querySelectorAll('#cronList em')].map(e=>e.textContent),btn:(document.querySelector('#cronList [data-cr=\"toggle\"]')||{}).textContent})"},
  {"shot": "c04-cron-paused"},
  {"click": "#cronList [data-cr=\"toggle\"]"},
  {"sleep": 500},
  {"click": "#cronList .rl.cron:nth-child(2) [data-cr=\"del\"]"},
  {"sleep": 500},
  {"eval": "({rows:document.querySelectorAll('#cronList .rl.cron').length,names:[...document.querySelectorAll('#cronList b')].map(b=>b.textContent)})"},

  {"click": "#cfgBtn"},
  {"sleep": 700},
  {"eval": "({eff:(document.querySelector('#fEff')||{}).value,ctx:(document.querySelector('#fCtx')||{}).value,max:(document.querySelector('#fMax')||{}).value,opts:[...(document.querySelectorAll('#fEff option')||[])].map(o=>o.value+':'+o.textContent.trim()),keyType:(document.querySelector('#fKey')||{}).type,keyBg:getComputedStyle(document.querySelector('#fKey')).backgroundColor,keyW:Math.round(document.querySelector('#fKey').getBoundingClientRect().width),effBg:getComputedStyle(document.querySelector('#fEff')).backgroundColor})"},
  {"shot": "c05-cfg-effort"},
  {"eval": "(()=>{const s=document.querySelector('#fEff');s.value='high';s.dispatchEvent(new Event('change'));return '已选 '+s.value})()"},
  {"click": "#cfgSave"},
  {"sleep": 700},
  {"eval": "fetch('/api/settings').then(r=>r.json()).then(c=>'服务端记下的 reasoningEffort=['+c.reasoningEffort+']')"},
  {"click": "#cfgBtn"},
  {"sleep": 700},
  {"eval": "({back:(document.querySelector('#fEff')||{}).value,label:(document.querySelector('#fEff')||{}).selectedOptions[0].textContent})"},
  {"eval": "(()=>{const s=document.querySelector('#fEff');s.value='';return '清回默认'})()"},
  {"click": "#cfgSave"},
  {"sleep": 500},
  {"eval": "fetch('/api/settings').then(r=>r.json()).then(c=>'清空之后=['+c.reasoningEffort+']（空=不发这个字段）')"}
]

[
  {"goto": "#box"},
  {"type": {"sel": "#box", "text": "看一下 @Serv", "enter": false}},
  {"sleep": 700},
  {"eval": "(()=>{const items=[...document.querySelectorAll('#slash .it')];return {open:document.querySelector('#slash').classList.contains('on'),items:items.length>=1,firstOk:!!items[0]&&items[0].textContent.indexOf('Server')>=0,hasSel:!!document.querySelector('#slash .it.sel')}})()",
   "must": ["open", "items", "firstOk", "hasSel"], "note": "@Serv 弹出文件补全：命中两条（Server.kt 排第一——按文件名前缀与短名排序）、首条选中"},
  {"shot": "a01-at-popup"},
  {"key": "Tab", "after": 300},
  {"eval": "(()=>{const idx=[...document.querySelectorAll('#slash .it')].findIndex(x=>x.classList.contains('sel'));return {moved:idx===1,boxKept:document.querySelector('#box').value.indexOf('@Serv')>=0}})()",
   "must": ["moved", "boxKept"], "note": "Tab 把选中挪到第二条、不动输入框里的字（Tab 变成跳焦点或插制表符=键盘挑文件这条路径坏掉）"},
  {"key": "ArrowUp", "after": 300},
  {"eval": "(()=>{const idx=[...document.querySelectorAll('#slash .it')].findIndex(x=>x.classList.contains('sel'));return {backAt0:idx===0}})()",
   "must": ["backAt0"], "note": "上方向键回到第一条（回车要落在这条上）"},
  {"key": "Enter", "after": 400},
  {"eval": "(()=>{const b=document.querySelector('#box');return {picked:b.value.indexOf('@src/main/kotlin/Server.kt')>=0,caret:b.selectionStart===b.value.length,closed:!document.querySelector('#slash').classList.contains('on')}})()",
   "must": ["picked", "caret", "closed"], "note": "回车补全的是第一条 Server.kt 的完整路径（Tab+上+回车这条链真跑通了）、光标落在补全后、菜单收掉"},
  {"shot": "a02-at-picked"},
  {"click": "#send"},
  {"sleep": 1200},
  {"eval": "(()=>{const u=document.querySelector('.msg.user');return {sent:!!u&&u.textContent.indexOf('@src/main/kotlin/Server.kt')>=0}})()",
   "must": ["sent"], "note": "发出去的那句话带着补全后的路径（补全只留在输入框里=模型收到的还是 @Serv）"},
  {"type": {"sel": "#box", "text": "@", "enter": false}},
  {"sleep": 800},
  {"eval": "(()=>{const items=[...document.querySelectorAll('#slash .it')];return {open:document.querySelector('#slash').classList.contains('on'),hasList:items.length>=1}})()",
   "must": ["open", "hasList"], "note": "光杆 @ 把整个文件清单列出来（空片段=列目录，不是弹也不是一片空）"},
  {"shot": "a03-at-all"},
  {"key": "Escape", "after": 300},
  {"eval": "(()=>({closed:!document.querySelector('#slash').classList.contains('on'),kept:document.querySelector('#box').value.length>0}))()",
   "must": ["closed", "kept"], "note": "Esc 收掉菜单但留着打的字（把输入清了=人白打一遍）"},
  {"type": {"sel": "#box", "text": "读 @notes/servicelog.txt 之前先看一眼", "enter": false}},
  {"sleep": 700},
  {"eval": "(()=>({closed:!document.querySelector('#slash').classList.contains('on')}))()",
   "must": ["closed"], "note": "@ 后面已经带了空格再接别的字：补全不弹（ATRE 锚在末尾——中途插一句就该安静）"},
  {"shot": "a04-at-notrig"},
  {"type": {"sel": "#box", "text": "路径中间不该弹：@src/main/kotlin/Server.kt", "enter": false}},
  {"sleep": 700},
  {"eval": "(()=>({closed:!document.querySelector('#slash').classList.contains('on'),hasText:document.querySelector('#box').value.length>10}))()",
   "must": ["closed", "hasText"], "note": "@ 前面是冒号（不在 ATRE 的起始字符集里）：不弹，原样留在输入框"},
  {"type": {"sel": "#box", "text": "/", "enter": false}},
  {"sleep": 500},
  {"eval": "(()=>{const items=[...document.querySelectorAll('#slash .it')];const first=items[0];const code=first?first.querySelector('code'):null;const cr=code?code.getBoundingClientRect():null;const t=first?first.querySelector('.tg'):null;return {open:document.querySelector('#slash').classList.contains('on'),many:items.length>=5,firstCmd:!!first&&first.textContent.replace(/\\s+/g,'').indexOf('/plan')===0,codeW:!!cr&&cr.width>0,noOverlap:!t||!!cr&&cr.right<=t.getBoundingClientRect().left+1}})()",
   "must": ["open", "many", "firstCmd", "codeW", "noOverlap"], "note": "斜杠菜单照常工作：五条以上命令、首条 /plan（模板串里 code 前有换行缩进，比对前先掐掉空白）、命令码有宽度、有技能标签时不与命令码叠着（@ 补全刚用过同一个浮层，验它没被带坏）"},
  {"shot": "a05-slash-still-ok"}
]

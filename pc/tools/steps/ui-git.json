[
  {
    "eval": "(()=>{const b=document.querySelector('#tabs button[data-t=git]');b.click();return JSON.stringify({tabOn:b.classList.contains('on'),panelOn:!!document.querySelector('#tab-git.on'),hasList:!!document.querySelector('#gitList')})})()",
    "must": [
      "tabOn",
      "panelOn",
      "hasList"
    ],
    "note": "Git 页签一点就开：按钮亮、面板在、列表容器在"
  },
  {
    "sleep": 1200
  },
  {
    "eval": "(()=>{const rows=[...document.querySelectorAll('#gitList .gr')].map(r=>r.querySelector('b').textContent+':'+r.querySelector('i').textContent);const head=document.querySelector('#gitHead').textContent,last=document.querySelector('#gitLast').textContent;return JSON.stringify({head,last,rows,three:rows.length==3,seesCjk:rows.join(',').indexOf('中文.txt')>=0,dirty:/不干净/.test(head),hasLastCommit:last.indexOf('上次提交')>=0})})()",
    "must": [
      "three",
      "seesCjk",
      "dirty",
      "hasLastCommit"
    ],
    "note": "三条改动都要列出来，**其中那条中文文件名尤其**：porcelain 的 -z 就是为了它（默认输出会把中文转义成八进制，界面上就是一片乱码或者干脆少一行）。head 那句要说清在哪个分支、干不干净"
  },
  {
    "eval": "(()=>{const r=document.querySelector('#gitList .gr');const cb=r.querySelector('input');const bb=r.querySelector('b').getBoundingClientRect();const ab=r.querySelector('[data-d]').getBoundingClientRect();const cr=r.getBoundingClientRect();const i=document.querySelector('#gitMsg').getBoundingClientRect();const b=document.querySelector('#gStage').getBoundingClientRect();return JSON.stringify({cbVisible:cb.getBoundingClientRect().width>0,pathEllipsis:bb.width>0&&bb.right<=cr.right+1,diffBtnInside:ab.right<=cr.right+1&&ab.left>bb.left-1,rowH:Math.round(cr.height),noOverflow:document.documentElement.scrollWidth<=document.documentElement.clientWidth+1,btnWidth:Math.round(ab.width),msgW:Math.round(document.querySelector('#gitMsg').getBoundingClientRect().width),msgOwnLine:i.bottom<=b.top+2})})()",
    "must": [
      "cbVisible",
      "pathEllipsis",
      "diffBtnInside",
      "noOverflow",
      "msgOwnLine"
    ],
    "note": "勾选框要看得见、路径不许溢出到行外、diff 按钮要在行内、整页不许横向滚、提交说明框要独占一行而不是把按钮挤下去。**期望值是 false 的那条（没有溢出）必须自己算成布尔**，must 里直接写 pageOverflow 会把「没溢出」判成失败"
  },
  {
    "click": "#gitList .gr input"
  },
  {
    "eval": "(()=>{const i=document.querySelector('#gitList .gr input');return {firstRow:i.dataset.p,checked:i.checked}})()",
    "must": [
      "firstRow",
      "checked"
    ],
    "note": "点第一行的勾选框：勾上的必须是 a.txt 本人（多元素共用 id/顺序错位那类 bug 就在这）"
  },
  {
    "click": "#gStage"
  },
  {
    "sleep": 1400
  },
  {
    "eval": "(()=>{const rows=[...document.querySelectorAll('#gitList .gr')];const staged=rows.filter(r=>r.classList.contains('st')).map(r=>r.querySelector('b').textContent);const state=document.querySelector('#gitState').textContent;return JSON.stringify({state,head:document.querySelector('#gitHead').textContent,staged,onlyA:staged.join(',')=='a.txt',saidOne:state.indexOf('已暂存 1')>=0})})()",
    "must": [
      "onlyA",
      "saidOne"
    ],
    "note": "暂存之后**只有那一条**带 [staged] 标（全表被标成已暂存 = 提交时才发现带上了别人不想提交的东西），状态那句要报出数字"
  },
  {
    "shot": "g01-staged"
  },
  {
    "click": "#gitList .gr [data-d]"
  },
  {
    "sleep": 1400
  },
  {
    "eval": "(()=>{const d=document.querySelector('#dialog');const pre=d?d.querySelector('pre'):null;const t=pre?pre.textContent:'';return JSON.stringify({maskOn:document.querySelector('#mask').classList.contains('on'),title:d?d.querySelector('h3').textContent:'',hasPlus:t.indexOf('+two changed')>=0,hasMinus:t.indexOf('-two')>=0,len:t.length,titleHasFile:(d?d.querySelector('h3').textContent:'').indexOf('a.txt')>=0})})()",
    "must": [
      "maskOn",
      "hasPlus",
      "hasMinus",
      "titleHasFile"

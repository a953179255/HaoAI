  {
    "eval": "(()=>{const rows=[...document.querySelectorAll('#gitList .gr')].map(r=>r.querySelector('b').textContent);const state=document.querySelector('#gitState').textContent;return JSON.stringify({state,head:document.querySelector('#gitHead').textContent,last:document.querySelector('#gitLast').textContent,rows,leftTwo:rows.length==2,committed:/已提交/.test(state),cjkLeft:rows.join(',').indexOf('中文.txt')>=0})})()",
    "must": [
      "leftTwo",
      "committed",
      "cjkLeft"

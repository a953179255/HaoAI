  {
    "eval": "fetch('/api/gitstage',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({sid:curId,paths:['../../outside.txt'],unstage:'0'})}).then(r=>r.json()).then(d=>JSON.stringify({ok:d.ok,error:d.error,blocked:d.ok!==true}))",
    "must": [
      "blocked"
    ],
    "note": "网络来的字符串不能直接当路径：`../../` 必须挡掉（这条口会把 paths 拼进 git 命令，挡不住就等于让手机上的一条请求去改工作区外的仓库）"
  },
  {
    "eval": "fetch('/api/gitstage',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({sid:curId,paths:['--no-verify'],unstage:'0'})}).then(r=>r.json()).then(d=>JSON.stringify({ok:d.ok,error:(d.error||'').slice(0,40),blocked:d.ok!==true}))",
    "must": [
      "blocked"
    ],
    "note": "以 `--` 开头的文件名要当参数注入处理（`--no-verify` 会跳过仓库自己的钩子）"
  },
  {
    "eval": "fetch('/api/state').then(r=>r.json()).then(s=>JSON.stringify({version:s.version,workspace:s.workspace,versionOk:(s.version||'').indexOf('-pc')>=0,wsIsRepo:(s.workspace||'').length>0}))",
    "must": [

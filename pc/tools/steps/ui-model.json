  {"eval": "(()=>{const b=[...document.querySelectorAll('.ans')].pop(),i=b.querySelector('img');i.scrollIntoView({block:'center'});return i.decode().then(()=>{const r=i.getBoundingClientRect(),bb=b.getBoundingClientRect(),q=document.querySelector('#stream');return{nat:i.naturalWidth+'x'+i.naturalHeight,shown:Math.round(r.width)+'x'+Math.round(r.height),bubble:Math.round(bb.width),overflow:r.right>bb.right+1,streamScroll:q.scrollWidth-q.clientWidth}}).catch(e=>({err:String(e)}))})()"},

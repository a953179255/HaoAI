  {
    "eval": "(async()=>{const t0=Date.now();for(;;){const d=await api('/lan/sessions').catch(()=>({items:[]}));for(const s of (d.items||[])){const one=await api('/lan/session?sid='+encodeURIComponent(s.id)).catch(()=>({}));const txt=(one.items||[]).map(m=>m.text).join('\\n');if(txt.indexOf('approved.txt')>=0)return JSON.stringify({approved:true,rundown:true,ms:Date.now()-t0,seen:txt.slice(-40)})}if(Date.now()-t0>45000)return JSON.stringify({approved:false,rundown:false,ms:Date.now()-t0});await new Promise(z=>setTimeout(z,1500))}})()",
    "must": [
      "approved",
      "rundown"
    ]
  },

  {
    "eval": "(()=>{window.rtStamp=document.querySelector('#stamp').textContent||'';return JSON.stringify({reloaded_listShown:!document.querySelector('#sList').hidden,reloaded_pairShown:!document.querySelector('#sPair').hidden,badgeOne:document.querySelector('#badge').textContent==='1',mark:window.rtStamp.length,hostRestored:(document.querySelector('#host').textContent||'').length>1})})()",

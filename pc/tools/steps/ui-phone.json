  {
    "eval": "(async()=>{const t0=Date.now();for(;;){const d=await api('/lan/sessions').catch(()=>({items:[]}));const hit=(d.items||[]).filter(s=>(s.title||'').indexOf('剪成 30 秒')>=0);if(hit.length)return JSON.stringify({sent:true,n:(d.items||[]).length,running:!!hit[0].running,mode:hit[0].mode});if(Date.now()-t0>40000)return JSON.stringify({sent:false,n:(d.items||[]).length});await new Promise(z=>setTimeout(z,1500))}})()",

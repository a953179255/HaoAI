  {
    "eval": "(()=>{const k=window.SKEY;let n=0;const e=[];for(let i=0;i<localStorage.length;i++){e.push(localStorage.key(i));n++}return JSON.stringify({storedLen:(localStorage.getItem(k)||'').length,keys:n,listShown:!document.querySelector('#sList').hidden,pairShown:!document.querySelector('#sPair').hidden,host:document.querySelector('#host').textContent,err:document.querySelector('#err').textContent,hostWide:(document.querySelector('#host').getBoundingClientRect().width>24)})})()",
    "must": [
      "storedLen",
      "keys",
      "listShown",
      "hostWide"
    ]
  },

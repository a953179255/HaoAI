    "eval": "(()=>{const c=document.querySelector('#appr .card');const txt=c?c.innerText:'';return JSON.stringify({showsTask:txt.indexOf('approved.txt')>=0||txt.indexOf('写入文件')>=0,buttons:c?c.querySelectorAll('button').length:0})})()",
    "must": [
      "showsTask"

[
  {"goto": "#box"},
  {"click": "#cfgBtn"},
  {"sleep": 900},
  {"eval": "({drawer:!!document.querySelector('#fKey'), state:(document.querySelector('#st-apikey')||{}).innerText, btn:(document.querySelector('[data-sec=apikey]')||{}).textContent, disabled:(document.querySelector('[data-sec=apikey]')||{disabled:true}).disabled})",
   "must": ["drawer", "state", "btn"], "note": "没设过的 key：撤掉那颗该是灰的（点不动的钮不该长得像能点）"},
  {"shot": "sc01-credential-empty"},

  {"type": {"sel": "#fKey", "text": "sk-pixel-abcdef123456", "enter": false}},
  {"click": "#cfgSave"},
  {"sleep": 1600},
  {"click": "#cfgBtn"},
  {"sleep": 900},
  {"eval": "(()=>{const st=(document.querySelector('#st-apikey')||{}).innerText||'';const page=document.body.innerText;const SECRET='sk-pixel-abcdef123456';return {state:st, showsSet:st.indexOf('已设置')>=0, masked:st.indexOf('sk…')>=0, showsLen:st.indexOf('21 位')>=0, noPlaintext:page.indexOf(SECRET)<0, inputEmpty:(document.querySelector('#fKey').value||'')==='', btnEnabled:document.querySelector('[data-sec=apikey]').disabled===false}})()",
   "must": ["showsSet", "masked", "showsLen", "noPlaintext", "inputEmpty", "btnEnabled"],
   "note": "状态行给掩码与长度，整页搜不到明文；输入框不回显旧值（回显会被当成新值写回去）"},
  {"shot": "sc02-credential-set"},

  {"click": "[data-sec=apikey]"},
  {"sleep": 300},
  {"eval": "({armed:(document.querySelector('[data-sec=apikey]')||{}).textContent, stillSet:(document.querySelector('#st-apikey')||{}).innerText})",
   "must": ["armed"], "note": "第一次点只改文案，不动盘：撤掉一把 key 会让所有请求当场失败"},
  {"click": "[data-sec=apikey]"},
  {"sleep": 1200},
  {"eval": "({state:(document.querySelector('#st-apikey')||{}).innerText, cleared:(document.querySelector('#st-apikey')||{}).innerText.indexOf('未设置')>=0, disabled:document.querySelector('[data-sec=apikey]').disabled===true})",
   "must": ["cleared", "disabled"]},
  {"shot": "sc03-credential-cleared"}
]

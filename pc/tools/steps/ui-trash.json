[
  {"goto": "#box"},
  {"eval": "(()=>{window.__real=sessList;sessList=Array.from({length:12},(_,i)=>({id:'fake'+i,title:'假会话 '+i,workspace:'C:/fake/ws',messages:3,mode:'auto',updated:Date.now()-i*60000}));markSessions();return 'seeded 12'})()"},
  {"eval": "(()=>{const rows=document.querySelectorAll('#sessions .it').length;return {capped:rows>=1&&rows<12,hasMore:!!document.querySelector('#sessions [data-more]')}})()",
   "must": ["capped", "hasMore"], "note": "12 条假会话进来：侧栏按上限截住并给出「更多」入口（不截=左栏被刷成一整屏）"},
  {"shot": "t01-capped-list"},
  {"click": "#sessions [data-more]"},
  {"sleep": 600},
  {"eval": "(()=>{const rows=document.querySelectorAll('#sessions .it').length;return {all:rows>=12,gone:!document.querySelector('#sessions [data-more]')}})()",
   "must": ["all", "gone"], "note": "点开「更多」：12 条全出来、「更多」入口收掉（点完还挂着=按钮白点）"},  {"shot": "t02-expanded"},
  {"eval": "(()=>{sessList=window.__real;markSessions();return 'restored'})()"},
  {"sleep": 600},
  {"eval": "(()=>{const id=curId;window.__gone=id;return fetch('/api/delete',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:id})}).then(r=>r.json()).then(x=>({ok:x.ok===true}))})()",
   "must": ["ok"], "note": "删会话接口认了（落进 .trash，下一步去回收站找它）"},
  {"sleep": 800},
  {"click": "#trashBtn"},
  {"sleep": 900},
  {"eval": "(()=>{const d=document.querySelector('#dialog');const h3=(d.querySelector('h3')||{}).textContent||'';return {on:document.querySelector('#mask').classList.contains('on'),title:h3.indexOf('回收站')>=0,rows:d.querySelectorAll('[data-back]').length>=1,purge:d.querySelectorAll('[data-purge]').length>=1}})()",
   "must": ["on", "title", "rows", "purge"], "note": "回收站对话框：开着、标题对、刚删的那条在列表里、每条都带「彻底删除」（找不回来的那种）"},
  {"shot": "t03-trash-dialog"},
  {"click": "#dialog [data-back]"},
  {"sleep": 1400},
  {"eval": "(()=>{return {mask:document.querySelector('#mask').classList.contains('on'),empty:document.querySelectorAll('#dialog [data-back]').length===0}})()",
   "must": ["mask", "empty"], "note": "找回之后它从回收站列表里消失（还挂着=点「找回」其实没生效），对话框不闪退"},
  {"eval": "fetch('/api/sessions').then(r=>r.json()).then(l=>({back:l.some(m=>m.id===window.__gone),has:l.length>0}))",
   "must": ["back", "has"], "note": "被找回的那条真回了会话列表（只从回收站列表里消失、列表里没有=丢了一条会话）"},
  {"click": "#dialog #tX"},
  {"sleep": 500},
  {"eval": "(()=>({closed:!document.querySelector('#mask').classList.contains('on'),side:document.querySelectorAll('#sessions .it').length>=1}))()",
   "must": ["closed", "side"], "note": "关掉对话框（mask 收）、左栏会话列表至少有找回的那条"},
  {"shot": "t04-restored"}
]

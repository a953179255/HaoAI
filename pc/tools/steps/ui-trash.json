[
  {"goto": "#box"},
  {"eval": "(()=>{window.__real=sessList;sessList=Array.from({length:12},(_,i)=>({id:'fake'+i,title:'假会话 '+i,workspace:'C:/fake/ws',messages:3,mode:'auto',updated:Date.now()-i*60000}));markSessions();return 'seeded 12'})()"},
  {"eval": "({rows:document.querySelectorAll('#sessions .it').length,more:(document.querySelector('#sessions [data-more]')||{}).textContent,groups:document.querySelectorAll('#sessions .wsg').length})"},
  {"shot": "t01-capped-list"},
  {"click": "#sessions [data-more]"},
  {"sleep": 600},
  {"eval": "({rowsAfter:document.querySelectorAll('#sessions .it').length,moreLeft:!!document.querySelector('#sessions [data-more]')})"},
  {"shot": "t02-expanded"},
  {"eval": "(()=>{sessList=window.__real;markSessions();return 'restored'})()"},
  {"sleep": 600},
  {"eval": "(()=>{const id=curId;window.__gone=id;return fetch('/api/delete',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:id})}).then(r=>r.json()).then(x=>'deleted '+x.ok)})()"},
  {"sleep": 800},
  {"click": "#trashBtn"},
  {"sleep": 900},
  {"eval": "({on:document.querySelector('#mask').classList.contains('on'),h3:document.querySelector('#dialog h3').textContent,rows:document.querySelectorAll('#dialog [data-back]').length,purge:document.querySelectorAll('#dialog [data-purge]').length,txt:document.querySelector('#dialog').textContent.replace(/\\s+/g,' ').slice(0,110)})"},
  {"shot": "t03-trash-dialog"},
  {"click": "#dialog [data-back]"},
  {"sleep": 1400},
  {"eval": "({toast:document.querySelector('#toast').textContent,mask:document.querySelector('#mask').classList.contains('on'),rows:document.querySelectorAll('#dialog [data-back]').length})"},
  {"eval": "fetch('/api/sessions').then(r=>r.json()).then(l=>'列表里 '+l.length+' 条，找回的那条在不在：'+l.some(m=>m.id===window.__gone))"},
  {"click": "#dialog #tX"},
  {"sleep": 500},
  {"eval": "({closed:!document.querySelector('#mask').classList.contains('on'),side:document.querySelectorAll('#sessions .it').length})"},
  {"shot": "t04-restored"}

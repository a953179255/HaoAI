   "text": "第一问：讲讲这种花怎么养"
  }
 },
 {
  "goto": ".msg.ans",
  "timeout": 25000
 },
 {
  "sleep": 2500
 },
 {
  "type": {
   "sel": "#box",
   "text": "第二问：换个话题说点别的"
  }
 },
 {
  "sleep": 3500
 },
 {
  "type": {
   "sel": "#box",
   "text": "第三问：最后再补一句"
  }
 },
 {
  "sleep": 3500
 },
 {
  "eval": "(()=>{window.__old=curId;return 'old '+curId.slice(0,6)})()"
 },
 {
  "click": "#newBtn"
 },
 {
  "sleep": 1200
 },
 {
  "type": {
   "sel": "#sessQ",
   "text": "换个话题",
   "enter": false
  }
 },
 {
  "sleep": 1200
 },
 {
   "eval": "(()=>{const first=document.querySelector('#sessions .it');const hit=first?first.dataset.hit:'';const snip=(document.querySelector('#sessions .hit')||{}).textContent||'';return {rows:document.querySelectorAll('#sessions .it').length>=1,hitFound:!!hit&&hit!=='-1',snip:snip.indexOf('换个话题')>=0}})()",
   "must": ["rows", "hitFound", "snip"],
   "note": "搜会话内容：搜出那条老会话、行上带命中下标（-1=没命中）、片段里就是要找的那句"
 },
 {
  "shot": "j01-search-hit"
 },
 {
  "click": "#sessions .it"
 },
 {
  "sleep": 900
 },
 {
   "eval": "(()=>{const v=document.querySelector('.view.on'),n=v&&v.querySelector('[data-index=\"2\"]'),q=document.querySelector('#stream').getBoundingClientRect(),r=n?n.getBoundingClientRect():{top:0,bottom:0};return({back:curId===window.__old,idxOnActive:v?v.querySelectorAll('[data-index]').length:-1,target:!!n,flash:!!document.querySelector('.view.on .flash'),inView:!!n&&r.top>=q.top-3&&r.bottom<=q.bottom+3,scroll:Math.round(document.querySelector('#stream').scrollTop)})})()",
   "must": ["back", "idxOnActive", "target", "flash", "inView"],
   "note": "点搜索结果跳回老会话：会话切回去、消息带下标（index 是服务端给的坐标）、第 2 条在、正闪着、且已经滚进视野（跳了但没滚动=人还得自己找）"
 },
 {
  "shot": "j02-jumped"
 },
 {
  "sleep": 2200
 },
 {
   "eval": "({flashGone:!document.querySelector('.view.on .flash'),stillThere:!!document.querySelector('.view.on [data-index=\"2\"]')})",
   "must": ["flashGone", "stillThere"],
   "note": "高亮自己退场（1.9 秒的提示不能永久挂着把正文染色），消息本体还在"
 },
 {
  "eval": "(()=>{openSession(window.__old,40);return 'jump-to-missing'})()"
 },
 {
  "eval": "(()=>{openSession(window.__old,40);return 'jump-to-missing'})()"
 },
 {
   "eval": "(()=>{const t=document.querySelector('#toast');return {toastOn:t.classList.contains('on'),says:t.textContent.indexOf('会话')>=0,stillCur:curId===window.__old}})()",
   "must": ["toastOn", "says", "stillCur"],
   "note": "跳到不存在的第 40 条：报错 toast 点亮（说的是「那一句不在这个会话里」）并留在原地（静默失败=人以为跳过去了）"
 },
 {
  "shot": "j03-missing-target"
 }
]
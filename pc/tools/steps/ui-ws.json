[
  {"goto": "#box"},
  {"sleep": 700},
  {"eval": "(()=>{const chip=$('#wsName').textContent;const title=$('#wsBtn').title;const head=document.querySelector('.sub2').textContent;return {chip:chip.length>0,wsInTitle:/ws$/.test(title),wsInHead:head.indexOf('ws')>=0}})()",
   "must": ["chip", "wsInTitle", "wsInHead"], "note": "初始状态：目录徽标有字、按钮 title 指向默认 ws 目录（下一步就靠它拼出兄弟目录）、副标题里带着工作区路径"},
  {"click": "#wsBtn"},
  {"sleep": 700},
  {"eval": "(()=>{const d=document.querySelector('#dialog');const h3=(d.querySelector('h3')||{}).textContent||'';return {mask:document.querySelector('#mask').classList.contains('on'),title:h3.indexOf('工作区')>=0,rows:d.querySelectorAll('.rl').length>=1,curTag:d.querySelectorAll('.ntag').length>=1,input:!!d.querySelector('#wIn'),go:!!d.querySelector('#wGo')}})()",
   "must": ["mask", "title", "rows", "curTag", "input", "go"], "note": "工作区对话框：开着、列出最近目录且当前那条挂着「当前」标签、输入框与按钮都在"},
  {"shot": "w01-ws-dialog"},
  {"type": {"sel": "#wIn", "text": "Q:/never-here-dir", "enter": false}},
  {"click": "#wGo"},
  {"sleep": 700},
  {"eval": "(()=>{const t=document.querySelector('#toast');return {toastOn:t.classList.contains('on'),says:t.textContent.indexOf('打不开')>=0,maskStillOpen:document.querySelector('#mask').classList.contains('on')}})()",
   "must": ["toastOn", "says", "maskStillOpen"], "note": "不存在的目录：明确说「打不开」，对话框留着让人改（关掉=刚敲的路径丢了）"},
  {"shot": "w02-ws-badpath"},
  {"eval": "(()=>{const w=$('#wsBtn').title;$('#wIn').value=w.replace(/ws$/,'other');$('#wIn').dispatchEvent(new Event('input',{bubbles:true}));return $('#wIn').value})()"},
  {"click": "#wGo"},
  {"sleep": 900},
  {"eval": "(()=>{const chip=$('#wsName').textContent;const head=document.querySelector('.sub2').textContent;return {closed:!document.querySelector('#mask').classList.contains('on'),other:chip.indexOf('other')>=0,headOther:head.indexOf('other')>=0,sessions:document.querySelectorAll('.sess .it').length>=2,cur:document.querySelectorAll('.sess .it.cur').length===1}})()",
   "must": ["closed", "other", "headOther", "sessions", "cur"], "note": "切到 other：对话框收掉、徽标与副标题都换了目录、侧栏两条会话（旧的没丢）、当前高亮唯一（原剧本用的是 .it.on——行上根本没有 on 这个类，恒 0 却没人看得见）"},
  {"shot": "w03-ws-switched"},
  {"click": "#wsBtn"},
  {"sleep": 700},
  {"eval": "(()=>{const d=document.querySelector('#dialog');return {rows:d.querySelectorAll('.rl').length>=2,curTag:d.querySelectorAll('.ntag').length>=1,openBtns:d.querySelectorAll('[data-ws]').length>=1}})()",
   "must": ["rows", "curTag", "openBtns"], "note": "两个目录之后：列表两条、当前那条挂标签、另一条带「另外开一」按钮（没有按钮=只能靠手输路径）"},
  {"shot": "w04-ws-two"},
  {"click": "#dialog [data-ws]"},
  {"sleep": 900},
  {"eval": "(()=>{const chip=$('#wsName').textContent;return {closed:!document.querySelector('#mask').classList.contains('on'),back:chip.indexOf('other')<0&&chip.length>0,sessions:document.querySelectorAll('.sess .it').length>=3}})()",
   "must": ["closed", "back", "sessions"], "note": "「另外开一」把人带回 ws：对话框收掉、徽标不再是 other、侧栏已有三条会话"},
  {"type": {"sel": "#box", "text": "在新工作区里写一句话就好"}},
  {"sleep": 1500},
  {"eval": "fetch('/api/sessions').then(r=>r.json()).then(l=>({three:l.length>=3,landed:l.some(s=>(s.title||'').indexOf('在新工作区')>=0&&/[\\\\/]ws$/.test(s.workspace||''))}))",
   "must": ["three", "landed"], "note": "这句话落进了在 ws 里的那条新会话（目标目录错了=人在 A 目录打字，东西写进 B）"},
  {"click": "#sessions .it:last-child"},
  {"sleep": 900},
  {"eval": "(()=>{const chip=$('#wsName').textContent;const head=document.querySelector('.sub2').textContent;const title=document.querySelector('#title').textContent;return {other:chip.indexOf('other')>=0,headOther:head.indexOf('other')>=0,hasTitle:title.length>0}})()",
   "must": ["other", "headOther", "hasTitle"], "note": "点侧栏切到另一条（other 那条）：徽标、副标题、标题三样一起换过去（只换标题不换目录=看着像切了其实没切）"}
]

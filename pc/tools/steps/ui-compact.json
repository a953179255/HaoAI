[
  {"goto": "#box"},
  {"type": {"sel": "#box", "text": "第一句：读一下 hello.txt"}},
  {"goto": ".msg.ans", "timeout": 25000},
  {"type": {"sel": "#box", "text": "第二句：再说一遍要点"}},
  {"sleep": 3500},
  {"type": {"sel": "#box", "text": "第三句：把要点压成两条"}},
  {"sleep": 3500},
  {"type": {"sel": "#box", "text": "第四句：顺手总结一下"}},
  {"sleep": 3500},
  {"click": "#tabs button[data-t=\"usage\"]"},
  {"sleep": 500},
  {"eval": "(()=>{const line=(document.querySelector('#ctxLine')||{}).textContent||'';const btn=(document.querySelector('#cmpBtn')||{}).textContent||'';return {line:line.indexOf('当前')>=0,btn:btn.length>0,grp:[...document.querySelectorAll('#tab-usage .grp')].length>=1}})()",
   "must": ["line", "btn", "grp"], "note": "用量页签上：占用行在报数、「压缩一次」按钮在、分组在（按钮不在=手动压缩这个入口没了）"},
  {"shot": "k01-ctx-line"},
  {"click": "#cmpBtn"},
  {"sleep": 2500},
  {"eval": "(()=>{const msgs=document.querySelectorAll('.view.on .msg').length;const st=document.querySelectorAll('.view.on .card').length;const nt=[...document.querySelectorAll('.notice')].map(x=>x.textContent);return {n:msgs,cards:st,fewer:msgs>0&&msgs<8,said:nt.some(t=>t.indexOf('压缩')>=0),why:'DOM 里 .msg='+msgs+' 张工具卡='+st+'；期望折完少于 8 条。同时读 /api/state 才能分清是「没重画」还是「服务端根本没折」'}})()",
   "must": ["fewer", "said"], "note": "手动压缩一次：消息条数要真的变少、流里要留下「已压缩并摘要 N 条」那一行（cmpState 是过程中的临时文案，收尾就清空，拿它当判据永远是空的）。**这条现在是红的（#135）**：已用二分证明不是引用出处那两批引入的；新加的 n/cards/why 三个读数是为了下次一跑就能分清「DOM 没重画」还是「服务端根本没折」，别再靠猜"},
  {"shot": "k02-after-compact"},
  {"click": "#ctxBtn"},
  {"sleep": 400},
  {"eval": "(()=>{const rows=[...document.querySelectorAll('#ctxPanel .row .lb')].map(x=>x.textContent);const foot=(document.querySelector('#ctxPanel .kv:last-child')||{}).textContent||'';return {open:document.querySelector('#ctxPanel').classList.contains('on'),rows:rows.length>=1,foot:foot.indexOf('合计')>=0}})()",
   "must": ["open", "rows", "foot"], "note": "占用面板：开着、有分项明细行、末行是合计（压完之后各部分的账要重新对得上）"},
  {"shot": "k03-ctx-panel"},
  {"click": "#ctxBtn"},
  {"type": {"sel": "#box", "text": "/comp", "enter": false}},
  {"sleep": 600},
  {"eval": "(()=>{const codes=[...document.querySelectorAll('#slash .it code')].map(x=>x.textContent);return {open:document.querySelector('#slash').classList.contains('on'),has:codes.some(c=>c.indexOf('/comp')===0)}})()",
   "must": ["open", "has"], "note": "打 /comp 就把压缩命令筛出来（菜单不弹=斜杠命令这条路断了）"},
  {"key": "Enter", "after": 2500},
  {"eval": "(()=>{const line=(document.querySelector('#ctxLine')||{}).textContent||'';return {box:document.querySelector('#box').value==='',line:line.indexOf('当前')>=0}})()",
   "must": ["box", "line"], "note": "回车执行命令：输入框被清掉（命令被吃掉而不是原样发给模型）、占用行还在"},
  {"shot": "k04-slash-compact"},
  {"eval": "setTimeout(()=>location.reload(),60)"},
  {"goto": "#box"},
  {"sleep": 1500},
  {"click": "#tabs button[data-t=\"usage\"]"},
  {"sleep": 500},
  {"eval": "(()=>{const line=(document.querySelector('#ctxLine')||{}).textContent||'';const msgs=document.querySelectorAll('.msg').length;return {line:line.indexOf('当前')>=0,kept:msgs>0&&msgs<8}})()",
   "must": ["line", "kept"], "note": "刷新之后压缩结果还在（压过的历史落了盘，不是只在内存里改了改）"},
  {"shot": "k05-after-reload"},
  {"note": "压缩那一次模型调用要进 Token 统计：先按接口口径确认账本里有 compact 这一档、且这次真的不为 0",
   "eval": "(async()=>{const d=await fetch('/api/usage').then(r=>r.json());const s=(d&&d.summary)||{};return {hasKey:Object.prototype.hasOwnProperty.call(s,'compact'),atLeastOne:(s.compact||0)>=1,n:s.compact||0}})()",
   "must": ["hasKey", "atLeastOne"]},
  {"click": "[data-view=\"tokens\"]", "note": "进 Token 统计整页，看那行口径说明在不在"},
  {"sleep": 1800},
  {"note": "页面上那句话必须与接口报的数一致 —— 数对不上的口径说明就是装饰",
   "eval": "(async()=>{const d=await fetch('/api/usage').then(r=>r.json());const n=((d&&d.summary)||{}).compact||0;const el=document.querySelector('#tkNote');const t=el?(el.textContent||''):'';return {shown:!!el,visible:!!(el&&el.offsetParent),saysCount:t.indexOf('压缩 '+n+' 次')>=0,hasMoney:t.indexOf('token')>=0}})()",
   "must": ["shown", "visible", "saysCount", "hasMoney"]},
  {"shot": "k06-compact-counted"}
]

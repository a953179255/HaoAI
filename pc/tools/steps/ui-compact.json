[
  {"goto": "#box"},
  {"type": {"sel": "#box", "text": "第一句：读一下 hello.txt"}},
  {"goto": ".msg.ans", "timeout": 25000},
  {"type": {"sel": "#box", "text": "第二句：再说一遍要点"}},
  {"sleep": 3500},
  {"type": {"sel": "#box", "text": "第三句：把要点压成两条"}},
  {"sleep": 3500},
  {"type": {"sel": "#box", "text": "第四句：顺手总结一下"}},
  {"sleep": 3500},
  {"click": "#tabs button[data-t=\"usage\"]"},
  {"sleep": 500},
  {"eval": "({line:document.querySelector('#ctxLine').textContent,btn:(document.querySelector('#cmpBtn')||{}).textContent,grp:[...document.querySelectorAll('#tab-usage .grp')].map(x=>x.textContent)})"},
  {"shot": "k01-ctx-line"},
  {"click": "#cmpBtn"},
  {"sleep": 2500},
  {"eval": "({toast:document.querySelector('#toast').textContent,line:document.querySelector('#ctxLine').textContent,state:document.querySelector('#cmpState').textContent,notices:[...document.querySelectorAll('.notice')].map(x=>x.textContent.slice(0,46)),msgs:document.querySelectorAll('.msg').length})"},
  {"shot": "k02-after-compact"},
  {"click": "#ctxBtn"},
  {"sleep": 400},
  {"eval": "({open:document.querySelector('#ctxPanel').classList.contains('on'),rows:[...document.querySelectorAll('#ctxPanel .row .lb')].map(x=>x.textContent),foot:document.querySelector('#ctxPanel .kv:last-child').textContent.replace(/\\s+/g,' ').trim()})"},
  {"shot": "k03-ctx-panel"},
  {"click": "#ctxBtn"},
  {"type": {"sel": "#box", "text": "/comp", "enter": false}},
  {"sleep": 600},
  {"eval": "({open:document.querySelector('#slash').classList.contains('on'),items:[...document.querySelectorAll('#slash .it code')].map(x=>x.textContent)})"},
  {"key": "Enter", "after": 2500},
  {"eval": "({toast:document.querySelector('#toast').textContent,line:document.querySelector('#ctxLine').textContent,box:document.querySelector('#box').value})"},
  {"shot": "k04-slash-compact"},
  {"eval": "setTimeout(()=>location.reload(),60)"},
  {"goto": "#box"},
  {"sleep": 1500},
  {"click": "#tabs button[data-t=\"usage\"]"},
  {"sleep": 500},
  {"eval": "({line:document.querySelector('#ctxLine').textContent,msgs:document.querySelectorAll('.msg').length})"},
  {"shot": "k05-after-reload"}
]

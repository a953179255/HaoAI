[
  {"goto": "#box"},
  {"click": "#cfgBtn"},
  {"goto": "#fKey"},
  {"eval": "(()=>{const f=document.getElementById('fKey');return {keyType:f.type==='password',ph:f.placeholder.indexOf('sk-')===0,rules:document.querySelectorAll('.rules .rl').length===0,add:!!document.getElementById('addRule')}})()",
   "must": ["keyType", "ph", "rules", "add"], "note": "设置抽屉里的几件事：API key 那格是密码框（不是明文回显）、带说明占位、权限规则区起始是空的（为下一步 0→1 留出增量）、添加按钮在"},
  {"shot": "s01-settings"},
  {"type": {"sel": "#fRule", "text": "shell(echo*) allow", "enter": false}},
  {"click": "#addRule"},
  {"sleep": 900},
  {"eval": "(()=>{const rules=document.querySelectorAll('.rules .rl').length;const texts=[...document.querySelectorAll('.rules .rl span')].map(s=>s.innerText).join(' | ');return {one:rules===1,hasIt:texts.indexOf('echo')>=0}})()",
   "must": ["one", "hasIt"], "note": "加规则真落进列表（0→1），且显示的就是刚敲进去的那条（不是占位文本）"},
  {"shot": "s02-rule-added"},
  {"click": ".rules [data-del]"},
  {"sleep": 900},
  {"eval": "(()=>({empty:document.querySelectorAll('.rules .rl').length===0,maskStill:document.getElementById('mask').classList.contains('on')}))()",
   "must": ["empty", "maskStill"], "note": "删掉之后列表回到空，且设置抽屉不闪退（删一条把整个抽屉关了=还得重新打开才能继续改）"},
  {"shot": "s03-rule-removed"},
  {"click": "#cfgClose"}
]

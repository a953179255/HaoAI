[
  {"goto": "#box"},
  {"type": {"sel": "#box", "text": "第一句话，跑一轮好让用量非零"}},
  {"goto": ".msg.ans", "timeout": 25000},
  {"sleep": 900},
  {"click": "#wsBtn"},
  {"sleep": 600},
  {"eval": "(()=>{const w=$('#wsBtn').title;$('#wIn').value=w.replace(/ws$/,'other');$('#wIn').dispatchEvent(new Event('input',{bubbles:true}));$('#wGo').click();return 'go other'})()"},
  {"sleep": 1000},
  {"type": {"sel": "#box", "text": "换到另一个目录里再说一句"}},
  {"goto": ".msg.ans", "timeout": 25000},
  {"sleep": 900},
  {"eval": "({groups:[...document.querySelectorAll('#sessions .wsg span')].map(x=>x.textContent),counts:[...document.querySelectorAll('#sessions .wsg i')].map(x=>x.textContent),items:document.querySelectorAll('#sessions .it').length,cur:document.querySelectorAll('#sessions .it.cur').length,chip:$('#wsName').textContent})"},
  {"shot": "g01-groups"},
  {"click": "#tabs button[data-t=\"usage\"]"},
  {"sleep": 500},
  {"eval": "({all:document.querySelector('#usageAll').textContent,now:document.querySelector('#usage2').textContent,grp:[...document.querySelectorAll('#tab-usage .grp')].map(x=>x.textContent)})"},
  {"shot": "g02-usage-total"},
  {"eval": "(()=>{const h=[...document.querySelectorAll('#sessions .wsg')];h[h.length-1].click();return '收起第 '+h.length+' 组'})()"},
  {"sleep": 500},
  {"eval": "({foldNote:[...document.querySelectorAll('#sessions .wsf')].map(x=>x.textContent),items:document.querySelectorAll('#sessions .it').length,marks:[...document.querySelectorAll('#sessions .wsg em')].map(x=>x.textContent),stored:localStorage.getItem('haoai-ws-fold')})"},
  {"shot": "g03-folded"},
  {"eval": "(()=>{const h=[...document.querySelectorAll('#sessions .wsg')];h[h.length-1].click();return '展开'})()"},
  {"sleep": 500},
  {"eval": "({items:document.querySelectorAll('#sessions .it').length,foldNote:[...document.querySelectorAll('#sessions .wsf')].map(x=>x.textContent),marks:[...document.querySelectorAll('#sessions .wsg em')].map(x=>x.textContent)})"},
  {"eval": "setTimeout(()=>location.reload(),60)"},
  {"goto": "#box"},
  {"sleep": 1200},
  {"eval": "({groups:[...document.querySelectorAll('#sessions .wsg span')].map(x=>x.textContent),items:document.querySelectorAll('#sessions .it').length,chip:$('#wsName').textContent})"},
  {"shot": "g05-after-reload"},
  {"type": {"sel": "#sessQ", "text": "一句", "enter": false}},
  {"sleep": 900},
  {"eval": "({groups:[...document.querySelectorAll('#sessions .wsg span')].map(x=>x.textContent),items:document.querySelectorAll('#sessions .it').length,hits:document.querySelectorAll('#sessions .hit').length})"},
  {"shot": "g04-search-grouped"},
  {"type": {"sel": "#sessQ", "text": "x", "enter": false}},
  {"eval": "$('#sessQ').value='';$('#sessQ').dispatchEvent(new Event('input',{bubbles:true}))"},
  {"sleep": 900},
  {"eval": "({groups:[...document.querySelectorAll('#sessions .wsg span')].map(x=>x.textContent),items:document.querySelectorAll('#sessions .it').length})"}
]

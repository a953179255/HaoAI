[
  {"goto": "#box"},
  {"type": {"sel": "#box", "text": "第一句话，跑一轮好让用量非零"}},
  {"goto": ".msg.ans", "timeout": 25000},
  {"sleep": 900},
  {"click": "#wsBtn"},
  {"sleep": 600},
  {"eval": "(()=>{const w=$('#wsBtn').title;$('#wIn').value=w.replace(/ws$/,'other');$('#wIn').dispatchEvent(new Event('input',{bubbles:true}));$('#wGo').click();return 'go other'})()"},
  {"sleep": 1000},
  {"type": {"sel": "#box", "text": "换到另一个目录里再说一句"}},
  {"goto": ".msg.ans", "timeout": 25000},
  {"sleep": 900},
  {"eval": "(()=>{const groups=[...document.querySelectorAll('#sessions .wsg span')].map(x=>x.textContent);const chip=$('#wsName').textContent;return {twoGroups:groups.length>=2,cur:document.querySelectorAll('#sessions .it.cur').length===1,other:chip.indexOf('other')>=0,items:document.querySelectorAll('#sessions .it').length>=2}})()",
   "must": ["twoGroups", "cur", "other", "items"], "note": "换到另一个目录再说一句之后：侧栏按工作区分成两组（一个目录时不分组，两个才显形）、当前那条有且只有一条、顶栏目录名是 other、两条会话都在"},
  {"shot": "g01-groups"},
  {"click": "#tabs button[data-t=\"usage\"]"},
  {"sleep": 500},
  {"eval": "(()=>{const all=(document.querySelector('#usageAll')||{}).textContent||'';const grp=[...document.querySelectorAll('#tab-usage .grp')];return {hasAll:all.length>0,grp:grp.length>=1}})()",
   "must": ["hasAll", "grp"], "note": "用量页签有总账与分组（跑过的两轮都记进去了）"},
  {"shot": "g02-usage-total"},
  {"eval": "(()=>{const h=[...document.querySelectorAll('#sessions .wsg')];h[h.length-1].click();return '收起第 '+h.length+' 组'})()"},
  {"sleep": 500},
  {"eval": "(()=>{const foldNote=[...document.querySelectorAll('#sessions .wsf')].map(x=>x.textContent);const stored=localStorage.getItem('haoai-ws-fold');return {note:foldNote.some(t=>t.indexOf('已收起')>=0),items:document.querySelectorAll('#sessions .it').length===1,stored:!!stored&&stored!=='[]'}})()",
   "must": ["note", "items", "stored"], "note": "点组头收起：那一组的会话被折掉（只剩另一组那条）、写着「N 条已收起」、折起状态落进 localStorage（刷新后还在）"},
  {"shot": "g03-folded"},
  {"eval": "(()=>{const h=[...document.querySelectorAll('#sessions .wsg')];h[h.length-1].click();return '展开'})()"},
  {"sleep": 500},
  {"eval": "(()=>{const foldNote=[...document.querySelectorAll('#sessions .wsf')].map(x=>x.textContent);return {back:document.querySelectorAll('#sessions .it').length===2,noFold:!foldNote.some(t=>t.indexOf('已收起')>=0)}})()",
   "must": ["back", "noFold"], "note": "再点展开：两条都回来、「已收起」那行消失"},
  {"eval": "setTimeout(()=>location.reload(),60)"},
  {"goto": "#box"},
  {"sleep": 1200},
  {"eval": "(()=>{const groups=[...document.querySelectorAll('#sessions .wsg span')].map(x=>x.textContent);const chip=$('#wsName').textContent;return {twoGroups:groups.length>=2,items:document.querySelectorAll('#sessions .it').length===2,other:chip.indexOf('other')>=0}})()",
   "must": ["twoGroups", "items", "other"], "note": "刷新之后：分组、条数、当前目录都还在（分组状态不靠内存撑着）"},
  {"shot": "g05-after-reload"},
  {"type": {"sel": "#sessQ", "text": "一句", "enter": false}},
  {"sleep": 900},
  {"eval": "(()=>{const groups=[...document.querySelectorAll('#sessions .wsg span')].map(x=>x.textContent);return {twoGroups:groups.length>=2,items:document.querySelectorAll('#sessions .it').length===2,hits:document.querySelectorAll('#sessions .hit').length>=2}})()",
   "must": ["twoGroups", "items", "hits"], "note": "搜「一句」：两条会话都命中（各自那句话都在片段里）、分组壳子还在（搜索不该把分组结构打散）"},
  {"shot": "g04-search-grouped"},
  {"type": {"sel": "#sessQ", "text": "x", "enter": false}},
  {"eval": "$('#sessQ').value='';$('#sessQ').dispatchEvent(new Event('input',{bubbles:true}))"},
  {"sleep": 900},
  {"eval": "(()=>{const groups=[...document.querySelectorAll('#sessions .wsg span')].map(x=>x.textContent);return {twoGroups:groups.length>=2,items:document.querySelectorAll('#sessions .it').length===2,noHits:document.querySelectorAll('#sessions .hit').length===0}})()",
   "must": ["twoGroups", "items", "noHits"], "note": "清掉搜索：完整列表回来、命中片段收掉（搜完残留=看着还是过滤态）"}
]

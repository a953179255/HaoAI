[
  {"goto": "#box"},
  {"click": "#cfgBtn"},
  {"goto": "#mcAdd"},
  {"sleep": 900},
  {"eval": "(()=>{const list=document.getElementById('mcpList');const flag=[...document.querySelectorAll('.sw .t')].map(x=>x.innerText).filter(t=>t.indexOf('MCP')>=0);return {hasList:!!list,hasFlag:flag.length>=1}})()",
   "must": ["hasList", "hasFlag"], "note": "MCP 那格在设置里：列表容器在、有个 MCP 相关的开关（开关都不在=这个功能在界面上没有入口）"},
  {"type": {"sel": "#mcName", "text": "mock", "enter": false}},
  {"type": {"sel": "#mcCmd", "text": "node G:/HaoAI/pc/tools/mock-mcp.js --mark C:/Users/95317/AppData/Local/Temp/mcp-ui-mark.txt", "enter": false}},
  {"click": "#mcAdd"},
  {"sleep": 4000},
  {"eval": "(()=>{const t=document.getElementById('mcpList').innerText;return {added:t.indexOf('mock')>=0,snippet:t.replace(/\\s+/g,' ').slice(0,90)}})()",
   "must": ["added"], "note": "加完列表里有 mock 这一条（名字都不显示=连接失败被静默吞了）；snippet 打印给人看连接状态"},
  {"shot": "x01-mcp-added"},
  {"click": "#mcpList [data-mdel]"},
  {"sleep": 1500},
  {"eval": "(()=>{const t=document.getElementById('mcpList').innerText;return {gone:t.indexOf('mock')<0}})()",
   "must": ["gone"], "note": "删完 mock 从列表消失（留下=删按钮没生效）"},
  {"click": "#cfgClose"},
  {"sleep": 400},
  {"eval": "(()=>({closed:document.getElementById('mask').classList.contains('on')===false}))()",
   "must": ["closed"], "note": "关掉设置抽屉（mask 收了）"}
]

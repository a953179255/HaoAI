<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>HaoAI-PC</AssemblyName>
    <AssemblyTitle>HaoAI PC</AssemblyTitle>
    <Product>HaoAI PC</Product>
    <Version>0.1.0</Version>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- 发布形态：框架依赖（WebView2 运行时 Windows 自带，.NET 运行时打包时带） -->
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <!-- ApplicationIcon 只把图标嵌进 exe 资源；壳是按路径读 app.ico 的（托盘/窗口共用），必须随发布拷出 -->
  <ItemGroup>
    <Content Include="app.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
